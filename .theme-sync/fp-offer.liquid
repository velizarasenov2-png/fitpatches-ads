{%- comment -%}
  FitPatches — Оферта (бъндъл избор + бърза поръчка с Purchase pixel)
  Самостоятелна секция. Настройки: цени, спестявания, Cloud endpoint, Pixel ID.
{%- endcomment -%}

{%- assign p = product -%}
{%- assign variant_id = product.selected_or_first_available_variant.id -%}
{%- assign cur = shop.currency -%}

<section
  class="fp-offer"
  id="fp-offer-{{ section.id }}"
  data-pixel="{{ section.settings.pixel_id }}"
  data-endpoint="{{ section.settings.cloud_endpoint }}"
  data-variant="{{ variant_id }}"
  data-product-handle="{{ product.handle }}"
  data-content-id="{{ section.settings.content_id | default: product.handle }}"
  data-currency="{{ cur }}">

  <div class="fp-offer__wrap">
    <h2 class="fp-offer__title">{{ section.settings.heading | default: 'Колко пакета желаете' }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="fp-offer__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="fp-offer__tiers" role="radiogroup" aria-label="Изберете пакет">
      {%- for i in (1..3) -%}
        {%- assign idx = i -%}
        {%- case idx -%}
          {%- when 1 -%}
            {%- assign packs = 1 -%}
            {%- assign patches = section.settings.patches_1 -%}
            {%- assign months = section.settings.months_1 -%}
            {%- assign total = section.settings.price_1 -%}
            {%- assign per_day = section.settings.perday_1 -%}
            {%- assign save = section.settings.save_1 -%}
            {%- assign badge = section.settings.badge_1 -%}
          {%- when 2 -%}
            {%- assign packs = 2 -%}
            {%- assign patches = section.settings.patches_2 -%}
            {%- assign months = section.settings.months_2 -%}
            {%- assign total = section.settings.price_2 -%}
            {%- assign per_day = section.settings.perday_2 -%}
            {%- assign save = section.settings.save_2 -%}
            {%- assign badge = section.settings.badge_2 -%}
          {%- when 3 -%}
            {%- assign packs = 3 -%}
            {%- assign patches = section.settings.patches_3 -%}
            {%- assign months = section.settings.months_3 -%}
            {%- assign total = section.settings.price_3 -%}
            {%- assign per_day = section.settings.perday_3 -%}
            {%- assign save = section.settings.save_3 -%}
            {%- assign badge = section.settings.badge_3 -%}
        {%- endcase -%}
        {%- assign per_pack = total | divided_by: packs -%}
        <label class="fp-tier{% if idx == section.settings.default_tier %} is-selected{% endif %}" data-tier="{{ idx }}">
          <input type="radio" name="fp-tier-{{ section.id }}" value="{{ idx }}"
                 data-packs="{{ packs }}" data-total="{{ total }}"
                 {% if idx == section.settings.default_tier %}checked{% endif %}>
          {%- if badge != blank -%}<span class="fp-tier__badge">{{ badge }}</span>{%- endif -%}
          <span class="fp-tier__radio" aria-hidden="true"></span>
          <span class="fp-tier__body">
            <span class="fp-tier__name">{{ packs }}
              {%- if packs == 1 %} пакет{% else %} пакета{% endif -%}
            </span>
            <span class="fp-tier__meta">{{ patches }} лепенки · {{ months }}
              {%- if months == 1 %} месец{% else %} месеца{% endif -%}
            </span>
            <span class="fp-tier__price">
              <span class="fp-tier__total">{{ total }} {{ cur }}</span>
              {%- if packs > 1 -%}<span class="fp-tier__unit">{{ per_pack }} {{ cur }} / пакет</span>{%- endif -%}
            </span>
            <span class="fp-tier__perday">{{ per_day }} {{ cur }} на ден</span>
          </span>
          {%- if save != blank -%}<span class="fp-tier__save">{{ save }}</span>{%- endif -%}
        </label>
      {%- endfor -%}
    </div>

    <div class="fp-offer__actions">
      <button type="button" class="fp-btn fp-btn--order" data-open-order>{{ section.settings.order_btn | default: 'Поръчай с наложен платеж' }}</button>
      <button type="button" class="fp-btn fp-btn--cart" data-add-cart>{{ section.settings.cart_btn | default: 'Добави в количката' }}</button>
    </div>

    <p class="fp-offer__reassure">{{ section.settings.reassure | default: 'Плащане при доставка · Доставка до 2–4 работни дни · Без предплащане' }}</p>

    <form class="fp-order" data-order-form hidden>
      <p class="fp-order__lead">{{ section.settings.form_lead | default: 'Оставете име и телефон — ще Ви се обадим за потвърждение на поръчката.' }}</p>
      <div class="fp-order__row">
        <input type="text" name="fp_name" placeholder="Вашето име" autocomplete="name" required>
      </div>
      <div class="fp-order__row">
        <input type="tel" name="fp_phone" placeholder="Телефон (напр. 0888 123 456)" autocomplete="tel"
               inputmode="tel" pattern="[0-9+ ]{6,}" required>
      </div>
      <div class="fp-order__summary" data-order-summary></div>
      <button type="submit" class="fp-btn fp-btn--submit">{{ section.settings.submit_btn | default: 'Потвърди поръчката' }}</button>
      <p class="fp-order__err" data-order-err hidden></p>
    </form>

    <div class="fp-order__success" data-order-success hidden>
      <strong>{{ section.settings.success_title | default: 'Благодарим! Поръчката е приета.' }}</strong>
      <span>{{ section.settings.success_text | default: 'Ще Ви се обадим скоро за потвърждение.' }}</span>
    </div>
  </div>
</section>

<style>
  #fp-offer-{{ section.id }}{--fp-accent: {{ section.settings.accent | default: '#1e874b' }};--fp-accent-soft:{{ section.settings.accent_soft | default: '#e8f5ee' }};}
  #fp-offer-{{ section.id }} .fp-offer__wrap{max-width:640px;margin:0 auto;padding:24px 16px}
  #fp-offer-{{ section.id }} .fp-offer__title{font-size:22px;font-weight:800;text-align:center;margin:0 0 4px}
  #fp-offer-{{ section.id }} .fp-offer__sub{text-align:center;color:#666;margin:0 0 18px;font-size:14px}
  #fp-offer-{{ section.id }} .fp-offer__tiers{display:flex;flex-direction:column;gap:12px}
  #fp-offer-{{ section.id }} .fp-tier{position:relative;display:flex;align-items:center;gap:14px;border:2px solid #e3e3e3;border-radius:14px;padding:16px 16px;cursor:pointer;transition:border-color .15s,box-shadow .15s;background:#fff}
  #fp-offer-{{ section.id }} .fp-tier.is-selected{border-color:var(--fp-accent);box-shadow:0 0 0 3px var(--fp-accent-soft)}
  #fp-offer-{{ section.id }} .fp-tier input{position:absolute;opacity:0;pointer-events:none}
  #fp-offer-{{ section.id }} .fp-tier__radio{flex:0 0 22px;width:22px;height:22px;border:2px solid #cfcfcf;border-radius:50%;position:relative}
  #fp-offer-{{ section.id }} .fp-tier.is-selected .fp-tier__radio{border-color:var(--fp-accent)}
  #fp-offer-{{ section.id }} .fp-tier.is-selected .fp-tier__radio:after{content:"";position:absolute;inset:4px;border-radius:50%;background:var(--fp-accent)}
  #fp-offer-{{ section.id }} .fp-tier__body{display:flex;flex-direction:column;gap:2px;flex:1}
  #fp-offer-{{ section.id }} .fp-tier__name{font-weight:800;font-size:16px}
  #fp-offer-{{ section.id }} .fp-tier__meta{color:#777;font-size:13px}
  #fp-offer-{{ section.id }} .fp-tier__price{display:flex;align-items:baseline;gap:8px;margin-top:2px;flex-wrap:wrap}
  #fp-offer-{{ section.id }} .fp-tier__total{font-weight:800;font-size:17px;color:var(--fp-accent)}
  #fp-offer-{{ section.id }} .fp-tier__unit{font-size:12px;color:#888}
  #fp-offer-{{ section.id }} .fp-tier__perday{font-size:12px;color:#999}
  #fp-offer-{{ section.id }} .fp-tier__badge{position:absolute;top:-11px;left:16px;background:var(--fp-accent);color:#fff;font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;letter-spacing:.3px}
  #fp-offer-{{ section.id }} .fp-tier__save{flex:0 0 auto;background:var(--fp-accent-soft);color:var(--fp-accent);font-weight:700;font-size:12px;padding:5px 9px;border-radius:8px;white-space:nowrap}
  #fp-offer-{{ section.id }} .fp-offer__actions{display:flex;flex-direction:column;gap:10px;margin-top:18px}
  #fp-offer-{{ section.id }} .fp-btn{border:0;border-radius:12px;padding:15px 18px;font-size:16px;font-weight:800;cursor:pointer;width:100%;transition:transform .05s,filter .15s}
  #fp-offer-{{ section.id }} .fp-btn:active{transform:translateY(1px)}
  #fp-offer-{{ section.id }} .fp-btn--order{background:var(--fp-accent);color:#fff}
  #fp-offer-{{ section.id }} .fp-btn--cart{background:#fff;color:#222;border:2px solid #ddd}
  #fp-offer-{{ section.id }} .fp-btn--submit{background:var(--fp-accent);color:#fff;margin-top:6px}
  #fp-offer-{{ section.id }} .fp-offer__reassure{text-align:center;color:#888;font-size:12px;margin:12px 0 0}
  #fp-offer-{{ section.id }} .fp-order{margin-top:16px;border:2px solid var(--fp-accent-soft);border-radius:14px;padding:16px;background:#fbfefc}
  #fp-offer-{{ section.id }} .fp-order__lead{margin:0 0 12px;font-size:14px;color:#444}
  #fp-offer-{{ section.id }} .fp-order__row{margin-bottom:10px}
  #fp-offer-{{ section.id }} .fp-order input{width:100%;padding:13px 14px;border:1.5px solid #d5d5d5;border-radius:10px;font-size:16px}
  #fp-offer-{{ section.id }} .fp-order input:focus{outline:none;border-color:var(--fp-accent)}
  #fp-offer-{{ section.id }} .fp-order__summary{font-size:14px;color:#333;margin:6px 0 4px;font-weight:600}
  #fp-offer-{{ section.id }} .fp-order__err{color:#c0392b;font-size:13px;margin:8px 0 0}
  #fp-offer-{{ section.id }} .fp-order__success{margin-top:16px;border:2px solid var(--fp-accent);border-radius:14px;padding:16px;background:var(--fp-accent-soft);display:flex;flex-direction:column;gap:4px;text-align:center}
</style>

<script>
(function(){
  var root = document.getElementById('fp-offer-{{ section.id }}');
  if(!root) return;
  var pixelId = root.dataset.pixel;
  var endpoint = root.dataset.endpoint;
  var variantId = root.dataset.variant;
  var contentId = root.dataset.contentId;
  var currency = root.dataset.currency || 'EUR';

  // Ensure fbq is available (defensive init if the FB app hasn't loaded it)
  if (pixelId && typeof window.fbq === 'undefined') {
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
    n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}
    (window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    window.fbq('init', pixelId);
  }

  var tiers = root.querySelectorAll('.fp-tier');
  var radios = root.querySelectorAll('input[name="fp-tier-{{ section.id }}"]');
  var orderForm = root.querySelector('[data-order-form]');
  var summary = root.querySelector('[data-order-summary]');
  var errEl = root.querySelector('[data-order-err]');
  var successEl = root.querySelector('[data-order-success]');

  function selected(){
    var r = root.querySelector('input[name="fp-tier-{{ section.id }}"]:checked');
    return { packs: parseInt(r.dataset.packs,10), total: parseFloat(r.dataset.total) };
  }
  function syncSelectedUI(){
    radios.forEach(function(r){
      r.closest('.fp-tier').classList.toggle('is-selected', r.checked);
    });
    var s = selected();
    if(summary){ summary.textContent = s.packs + (s.packs===1?' пакет':' пакета') + ' · ' + s.total.toFixed(2) + ' ' + currency + ' с доставка'; }
  }
  radios.forEach(function(r){ r.addEventListener('change', syncSelectedUI); });
  syncSelectedUI();

  // Add to cart (native Shopify)
  var addBtn = root.querySelector('[data-add-cart]');
  if(addBtn){
    addBtn.addEventListener('click', function(){
      var s = selected();
      addBtn.disabled = true; var old = addBtn.textContent; addBtn.textContent = 'Добавяне…';
      fetch('/cart/add.js', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ id: variantId, quantity: s.packs })
      }).then(function(){
        if(window.fbq){ window.fbq('track','AddToCart',{content_ids:[contentId],content_type:'product',value:s.total,currency:currency,num_items:s.packs}); }
        window.location.href = '/cart';
      }).catch(function(){ addBtn.disabled=false; addBtn.textContent=old; });
    });
  }

  // Open quick-order form
  var openBtn = root.querySelector('[data-open-order]');
  if(openBtn){
    openBtn.addEventListener('click', function(){
      orderForm.hidden = false;
      orderForm.scrollIntoView({behavior:'smooth', block:'center'});
      var f = orderForm.querySelector('input[name="fp_name"]'); if(f) f.focus();
    });
  }

  // Submit quick-order form
  if(orderForm){
    orderForm.addEventListener('submit', function(e){
      e.preventDefault();
      errEl.hidden = true;
      var name = orderForm.querySelector('input[name="fp_name"]').value.trim();
      var phone = orderForm.querySelector('input[name="fp_phone"]').value.trim();
      var digits = phone.replace(/[^0-9]/g,'');
      if(name.length < 2){ errEl.textContent='Моля, въведете име.'; errEl.hidden=false; return; }
      if(digits.length < 6){ errEl.textContent='Моля, въведете валиден телефон.'; errEl.hidden=false; return; }
      var s = selected();

      // Guard: do not fire the pixel for internal test orders
      var isTest = /\btest\b|\bтест\b|notrack/i.test(name);

      // 1) Fire Purchase to Meta pixel
      if(!isTest && window.fbq){
        window.fbq('track','Purchase',{
          value: s.total, currency: currency,
          content_ids:[contentId], content_name:'FitPatches',
          content_type:'product', num_items: s.packs
        });
      }

      // 2) Send the order to the Cloud endpoint (name/phone/qty/total)
      var payload = {
        name: name, phone: phone, packs: s.packs, total: s.total,
        currency: currency, product: contentId, variant_id: variantId,
        page: window.location.href, ts: Date.now()
      };
      if(endpoint){
        try{
          var blob = new Blob([JSON.stringify(payload)], {type:'text/plain;charset=UTF-8'});
          if(navigator.sendBeacon){ navigator.sendBeacon(endpoint, blob); }
          else { fetch(endpoint,{method:'POST',body:JSON.stringify(payload),mode:'no-cors',keepalive:true}); }
        }catch(err){}
      }

      // 3) Also drop the item in the Shopify cart so it is recoverable
      try{
        fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ id: variantId, quantity: s.packs, properties:{'Бърза поръчка':name+' / '+phone} }), keepalive:true});
      }catch(err){}

      // 4) Show success
      orderForm.hidden = true;
      successEl.hidden = false;
      successEl.scrollIntoView({behavior:'smooth', block:'center'});
    });
  }
})();
</script>

{% schema %}
{
  "name": "FitPatches Оферта",
  "tag": "section",
  "class": "fp-offer-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Заглавие", "default": "Колко пакета желаете" },
    { "type": "text", "id": "subheading", "label": "Подзаглавие", "default": "Повечето клиенти избират 2–3 пакета за пълен резултат." },
    { "type": "header", "content": "Пиксел и Cloud" },
    { "type": "text", "id": "pixel_id", "label": "Meta Pixel ID", "default": "1051819453965625" },
    { "type": "url", "id": "cloud_endpoint", "label": "Cloud endpoint (Apps Script / Worker) за записване на поръчката" },
    { "type": "text", "id": "content_id", "label": "Content ID за пиксела", "default": "fitpatches" },
    { "type": "header", "content": "Пакет 1" },
    { "type": "text", "id": "patches_1", "label": "Брой лепенки", "default": "30" },
    { "type": "text", "id": "months_1", "label": "Месеци", "default": "1" },
    { "type": "text", "id": "price_1", "label": "Цена (общо)", "default": "14.99" },
    { "type": "text", "id": "perday_1", "label": "На ден", "default": "0.50" },
    { "type": "text", "id": "save_1", "label": "Спестявате (текст)", "default": "" },
    { "type": "text", "id": "badge_1", "label": "Баджа", "default": "" },
    { "type": "header", "content": "Пакет 2" },
    { "type": "text", "id": "patches_2", "label": "Брой лепенки", "default": "60" },
    { "type": "text", "id": "months_2", "label": "Месеци", "default": "2" },
    { "type": "text", "id": "price_2", "label": "Цена (общо)", "default": "24.99" },
    { "type": "text", "id": "perday_2", "label": "На ден", "default": "0.42" },
    { "type": "text", "id": "save_2", "label": "Спестявате (текст)", "default": "Спести 5 лв" },
    { "type": "text", "id": "badge_2", "label": "Баджа", "default": "" },
    { "type": "header", "content": "Пакет 3" },
    { "type": "text", "id": "patches_3", "label": "Брой лепенки", "default": "90" },
    { "type": "text", "id": "months_3", "label": "Месеци", "default": "3" },
    { "type": "text", "id": "price_3", "label": "Цена (общо)", "default": "32.99" },
    { "type": "text", "id": "perday_3", "label": "На ден", "default": "0.37" },
    { "type": "text", "id": "save_3", "label": "Спестявате (текст)", "default": "Спести 12 лв" },
    { "type": "text", "id": "badge_3", "label": "Баджа", "default": "Най-популярен" },
    { "type": "header", "content": "Поведение" },
    { "type": "range", "id": "default_tier", "label": "Избран по подразбиране", "min": 1, "max": 3, "step": 1, "default": 3 },
    { "type": "text", "id": "order_btn", "label": "Бутон поръчка", "default": "Поръчай с наложен платеж" },
    { "type": "text", "id": "cart_btn", "label": "Бутон количка", "default": "Добави в количката" },
    { "type": "text", "id": "reassure", "label": "Уверение", "default": "Плащане при доставка · Доставка до 2–4 работни дни · Без предплащане" },
    { "type": "text", "id": "form_lead", "label": "Текст над формата", "default": "Оставете име и телефон — ще Ви се обадим за потвърждение на поръчката." },
    { "type": "text", "id": "submit_btn", "label": "Бутон изпращане", "default": "Потвърди поръчката" },
    { "type": "text", "id": "success_title", "label": "Успех заглавие", "default": "Благодарим! Поръчката е приета." },
    { "type": "text", "id": "success_text", "label": "Успех текст", "default": "Ще Ви се обадим скоро за потвърждение." },
    { "type": "header", "content": "Цветове" },
    { "type": "color", "id": "accent", "label": "Основен цвят", "default": "#1e874b" },
    { "type": "color", "id": "accent_soft", "label": "Светъл акцент", "default": "#e8f5ee" }
  ],
  "presets": [ { "name": "FitPatches Оферта" } ]
}
{% endschema %}
