{%- comment -%}
  FitPatches — бутон за изтегляне на е-книгата „30 дни баланс“ на страницата „Благодарим“ (/pages/thank-you).
  Показва се, ако в количката при поръчката е имало е-книга (sessionStorage „fp_ebook“, записва го snippets/fp-ebook-gift.liquid).
  Демо: /pages/thank-you?fp_demo=1&ebook=1&t=39.99
{%- endcomment -%}
<style>
  .fpty-eb{display:flex;flex-wrap:wrap;align-items:center;gap:12px 14px;margin:0 0 18px;padding:14px;border:2px solid #f6cfe1;border-radius:16px;
    background:linear-gradient(135deg,#fff8fb 0%,#fde8f1 100%);text-align:left}
  .fpty-eb__img{flex:0 0 56px;width:56px;height:auto;transform:rotate(-6deg);filter:drop-shadow(0 5px 8px rgba(86,28,59,.28))}
  .fpty-eb__info{flex:1 1 160px;min-width:0;display:flex;flex-direction:column;gap:3px;line-height:1.25}
  .fpty-eb__tag{align-self:flex-start;background:#d64d87;color:#fff;font-size:11px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;border-radius:999px;padding:3px 9px}
  .fpty-eb__info b{font-size:17px;color:#111}
  .fpty-eb__info span:last-child{font-size:13px;color:#666}
  .fpty-eb__btn{flex:1 0 100%;display:block;text-align:center;background:#561C3B;color:#fff!important;text-decoration:none;font-weight:800;font-size:16px;border-radius:12px;padding:14px 12px}
  .fpty-eb__note{flex:1 0 100%;margin:0;font-size:12px;color:#777;text-align:center}
</style>
<script>
(function(){
  if(location.pathname.indexOf('/pages/thank-you')!==0) return;
  var PDF='https://cdn.shopify.com/s/files/1/1048/3269/6657/files/30-dni-balans-FitPatches.pdf?v=1794411601';
  var THUMB='https://cdn.shopify.com/s/files/1/1048/3269/6657/files/fp-ebook-thumb.png?v=1794411601&width=160';
  var q=new URLSearchParams(location.search), on=false;
  try{ on=sessionStorage.getItem('fp_ebook')==='1'; }catch(e){}
  if(q.get('fp_demo')==='1' && q.get('ebook')==='1') on=true;
  if(!on) return;
  function put(){
    var card=document.querySelector('.fpty-page__card'); if(!card || card.querySelector('.fpty-eb')) return;
    var html='<div class="fpty-eb">'
      +'<img class="fpty-eb__img" src="'+THUMB+'" alt="" width="56" height="81">'
      +'<div class="fpty-eb__info"><span class="fpty-eb__tag">Твоят подарък</span><b>Е-книга „30 дни баланс“</b><span>30-дневен план, меню и 10 рецепти (PDF)</span></div>'
      +'<a class="fpty-eb__btn" href="'+PDF+'" target="_blank" rel="noopener" download>Изтегли е-книгата</a>'
      +'<p class="fpty-eb__note">Запази файла на телефона си. Започни още днес с Ден 1.</p>'
      +'</div>';
    var before=card.querySelector('.fpty-page__text');
    if(before) before.insertAdjacentHTML('beforebegin',html); else card.insertAdjacentHTML('beforeend',html);
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',put); else put();
})();
</script>
