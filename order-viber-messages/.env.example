# За пускане на компютър: копирайте като .env и стартирайте с  node --env-file=.env src/run.js
# В GitHub Actions същите стойности се въвеждат в Settings → Secrets and variables → Actions.

# --- Shopify (Dev Dashboard app със scopes read_orders и write_orders) ---
SHOPIFY_SHOP=99adx5-f2.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# SHOPIFY_ACCESS_TOKEN=shpat_...      # само ако имате стар custom app токен вместо Client ID/Secret

# --- BulkGate (Modules & APIs → Advanced API) ---
BULKGATE_APP_ID=
BULKGATE_TOKEN=
VIBER_SENDER=                        # одобреното Viber име (напр. FitPatches). Празно = само SMS
# VIBER_TEMPLATES=true               # праща одобрените Viber шаблони (npm run templates). false = обикновен текст
# VIBER_EXPIRATION=3600              # секунди за Viber, преди да тръгне SMS
# SMS_SENDER_ID=gSystem              # gText + SMS_SENDER_VALUE=FitPatches, когато одобрят текстов подател
# SMS_SENDER_VALUE=

# --- Режим ---
LIVE=false                           # false = само показва какво би пратил. true = праща наистина
TEST_PHONE=                          # ако е попълнен, ВСИЧКО отива на този телефон
START_AT=                            # напр. 2026-10-27T08:00:00+02:00 – по-старите поръчки не получават благодарност
# PRINT_TEXTS=true                   # показва целите текстове (само на компютър, не в GitHub)

# --- Настройки (по подразбиране) ---
# SUPPORT_PHONE=0887459494
# SEND_HOURS=08:00-21:00
# REMINDER_DAYS=2,4
# THANKS_DELAY_MINUTES=5
# LOOKBACK_DAYS=14
# MAX_SENDS_PER_RUN=40
