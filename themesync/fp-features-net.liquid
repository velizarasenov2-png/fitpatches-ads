{%- comment -%} FitPatches — Природата (въртяща се ЛЕПЕНКА, HD + изнесени етикети) {%- endcomment -%}
{%- assign vid = 'https://cdn.shopify.com/s/files/1/1048/3269/6657/files/fp-patch-spin.mp4?v=1786453852' -%}
<section class="fp-feat" id="fpf-{{ section.id }}">
  <div class="fp-feat__wrap">
    <h2 class="fp-feat__title">Природата в помощ на фигурата.<br><span>Без хапчета. Без мъчение.</span></h2>

    <div class="fp-feat__stage">
      <div class="fp-feat__col fp-feat__col--l">
        <div class="fp-feat__it">
          <span class="fp-feat__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 7 9 13 13 10 21 16"/><polyline points="16 16 21 16 21 11"/></svg></span>
          <div><b>Без глад</b><span>Потиска апетита по естествен начин.</span></div>
        </div>
        <div class="fp-feat__it">
          <span class="fp-feat__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20C4 12 10 5 20 4c-1 9-7 16-16 16z"/><path d="M4 20c3-6 7-9.5 12-11.5"/></svg></span>
          <div><b>Натурално</b><span>Берберин и растителни екстракти.</span></div>
        </div>
      </div>

      <div class="fp-feat__media">
        <span class="fp-feat__glow"></span>
        <video class="fp-feat__vid" autoplay loop muted playsinline preload="metadata">
          <source src="{{ vid }}" type="video/mp4">
        </video>
      </div>

      <div class="fp-feat__col fp-feat__col--r">
        <div class="fp-feat__it">
          <span class="fp-feat__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="8" width="16" height="8" rx="4"/><path d="M8 12h8"/></svg></span>
          <div><b>Дискретно</b><span>Тънка лепенка, незабележима под дрехите.</span></div>
        </div>
        <div class="fp-feat__it">
          <span class="fp-feat__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg></span>
          <div><b>Лесно</b><span>Една лепенка сутрин и забравяш за нея.</span></div>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  #fpf-{{ section.id }}{--a:#d64d87;--soft:#fbe9f1;--warm:#faf0f4}
  #fpf-{{ section.id }} .fp-feat__wrap{max-width:1180px;margin:0 auto;padding:52px 18px}
  #fpf-{{ section.id }} .fp-feat__title{text-align:center;font-size:34px;font-weight:800;color:#111;line-height:1.15;margin:0 0 34px}
  #fpf-{{ section.id }} .fp-feat__title span{color:var(--a)}
  #fpf-{{ section.id }} .fp-feat__stage{display:grid;grid-template-columns:1fr minmax(360px,520px) 1fr;align-items:center;gap:24px}
  #fpf-{{ section.id }} .fp-feat__col{display:flex;flex-direction:column;gap:44px}
  #fpf-{{ section.id }} .fp-feat__it{display:flex;flex-direction:column;gap:6px}
  #fpf-{{ section.id }} .fp-feat__col--l .fp-feat__it{align-items:flex-end;text-align:right}
  #fpf-{{ section.id }} .fp-feat__col--r .fp-feat__it{align-items:flex-start;text-align:left}
  #fpf-{{ section.id }} .fp-feat__ic{width:50px;height:50px;border-radius:50%;background:var(--soft);color:var(--a);display:flex;align-items:center;justify-content:center}
  #fpf-{{ section.id }} .fp-feat__ic svg{width:25px;height:25px}
  #fpf-{{ section.id }} .fp-feat__it b{display:block;font-size:16px;color:#111;margin-bottom:2px}
  #fpf-{{ section.id }} .fp-feat__it span{color:#666;font-size:13.5px;line-height:1.4;max-width:200px;display:block}
  #fpf-{{ section.id }} .fp-feat__media{position:relative;display:flex;align-items:center;justify-content:center}
  #fpf-{{ section.id }} .fp-feat__glow{position:absolute;width:92%;aspect-ratio:1/1;border-radius:50%;background:radial-gradient(circle,var(--soft) 0,rgba(251,233,241,0) 70%);z-index:0}
  #fpf-{{ section.id }} .fp-feat__vid{position:relative;z-index:1;width:100%;border-radius:22px;display:block;background:var(--warm)}
  @media(max-width:749px){
    #fpf-{{ section.id }} .fp-feat__title{font-size:25px;margin:0 0 24px}
    #fpf-{{ section.id }} .fp-feat__stage{grid-template-columns:1fr;gap:26px}
    #fpf-{{ section.id }} .fp-feat__media{order:-1}
    #fpf-{{ section.id }} .fp-feat__vid{max-width:440px;width:100%;margin:0 auto}
    #fpf-{{ section.id }} .fp-feat__col{flex-direction:row;gap:16px}
    #fpf-{{ section.id }} .fp-feat__col .fp-feat__it{flex:1}
    #fpf-{{ section.id }} .fp-feat__col--l .fp-feat__it,#fpf-{{ section.id }} .fp-feat__col--r .fp-feat__it{align-items:center;text-align:center}
    #fpf-{{ section.id }} .fp-feat__it span{max-width:none}
  }
</style>
{% schema %}
{ "name": "FitPatches Природа", "tag": "section", "settings": [], "presets": [ { "name": "FitPatches Природа" } ] }
{% endschema %}
