{%- comment -%} FitPatches — движеща се лента с предимства {%- endcomment -%}
{%- assign items = 'Потиска глада,По-малко желание за сладко,Повече енергия,Натурални съставки,Без хапчета,Трансдермално действие,Без странични ефекти,Една лепенка на ден' | split: ',' -%}
<div class="fp-ticker" id="fpt-{{ section.id }}">
  <div class="fp-ticker__track">
    {%- for n in (1..2) -%}
      {%- for it in items -%}
        <span class="fp-ticker__item"><span class="fp-ticker__dot"></span>{{ it }}</span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>
<style>
  #fpt-{{ section.id }}{--a:#d64d87;background:#fbe9f1;overflow:hidden;padding:15px 0}
  #fpt-{{ section.id }} .fp-ticker__track{display:flex;gap:34px;white-space:nowrap;width:max-content;animation:fpt-{{ section.id }} 32s linear infinite}
  #fpt-{{ section.id }} .fp-ticker__item{display:inline-flex;align-items:center;gap:12px;font-weight:800;color:var(--a);font-size:14px;letter-spacing:.4px;text-transform:uppercase}
  #fpt-{{ section.id }} .fp-ticker__dot{width:7px;height:7px;border-radius:50%;background:var(--a)}
  @keyframes fpt-{{ section.id }}{from{transform:translateX(0)}to{transform:translateX(-50%)}}
</style>
{% schema %}
{ "name": "FitPatches Лента", "tag": "section", "settings": [], "presets": [ { "name": "FitPatches Лента" } ] }
{% endschema %}
