{%- comment -%} FitPatches — Природата в помощ на фигурата (снимка + 4 предимства) {%- endcomment -%}
{%- assign img = section.settings.image -%}
<section class="fp-feat" id="fpf-{{ section.id }}">
  <div class="fp-feat__wrap">
    <p class="fp-feat__eyebrow">ПРИРОДЕН КОНТРОЛ НА АПЕТИТА</p>
    <h2 class="fp-feat__title">Природата в помощ на фигурата.</h2>
    <div class="fp-feat__grid">
      <div class="fp-feat__media">
        {%- if img != blank -%}
          <img src="{{ img | image_url: width: 900 }}" alt="FitPatches" loading="lazy">
        {%- else -%}
          <div class="fp-feat__ph">снимка<br>на продукта</div>
        {%- endif -%}
      </div>
      <div class="fp-feat__items">
        <div class="fp-feat__it"><span class="fp-feat__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 7 9 13 13 10 21 16"/><polyline points="16 16 21 16 21 11"/></svg></span><div><b>Без глад</b><span>Потиска апетита по естествен начин.</span></div></div>
        <div class="fp-feat__it"><span class="fp-feat__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20C4 12 10 5 20 4c-1 9-7 16-16 16z"/><path d="M4 20c3-6 7-9.5 12-11.5"/></svg></span><div><b>Натурално</b><span>Берберин и растителни екстракти.</span></div></div>
        <div class="fp-feat__it"><span class="fp-feat__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="8" width="16" height="8" rx="4"/><path d="M8 12h8"/></svg></span><div><b>Дискретно</b><span>Тънка лепенка, незабележима под дрехите.</span></div></div>
        <div class="fp-feat__it"><span class="fp-feat__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg></span><div><b>Лесно</b><span>Една лепенка сутрин и забравяш за нея.</span></div></div>
      </div>
    </div>
  </div>
</section>
<style>
  #fpf-{{ section.id }}{--a:#d64d87;--soft:#fbe9f1;--warm:#faf0f4}
  #fpf-{{ section.id }} .fp-feat__wrap{max-width:1040px;margin:0 auto;padding:48px 18px}
  #fpf-{{ section.id }} .fp-feat__eyebrow{text-align:center;color:var(--a);font-weight:800;letter-spacing:1px;font-size:12px;margin:0 0 8px}
  #fpf-{{ section.id }} .fp-feat__title{text-align:center;font-size:32px;font-weight:800;color:#111;margin:0 0 32px}
  #fpf-{{ section.id }} .fp-feat__grid{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:center}
  #fpf-{{ section.id }} .fp-feat__media img{width:100%;border-radius:16px;display:block}
  #fpf-{{ section.id }} .fp-feat__ph{width:100%;aspect-ratio:1/1;border:2px dashed #e3b3ca;border-radius:16px;display:flex;align-items:center;justify-content:center;color:#c98bab;background:var(--warm);text-align:center;font-size:14px}
  #fpf-{{ section.id }} .fp-feat__items{display:grid;grid-template-columns:1fr 1fr;gap:24px}
  #fpf-{{ section.id }} .fp-feat__it{display:flex;flex-direction:column;gap:8px}
  #fpf-{{ section.id }} .fp-feat__ic{width:48px;height:48px;border-radius:50%;background:var(--soft);color:var(--a);display:flex;align-items:center;justify-content:center}
  #fpf-{{ section.id }} .fp-feat__ic svg{width:24px;height:24px}
  #fpf-{{ section.id }} .fp-feat__it b{display:block;font-size:16px;color:#111;margin-bottom:2px}
  #fpf-{{ section.id }} .fp-feat__it span{color:#666;font-size:14px;line-height:1.4}
  @media(max-width:749px){
    #fpf-{{ section.id }} .fp-feat__grid{grid-template-columns:1fr;gap:24px}
    #fpf-{{ section.id }} .fp-feat__title{font-size:26px}
  }
</style>
{% schema %}
{ "name": "FitPatches Природа", "tag": "section", "settings": [ { "type": "image_picker", "id": "image", "label": "Снимка на продукта" } ], "presets": [ { "name": "FitPatches Природа" } ] }
{% endschema %}
