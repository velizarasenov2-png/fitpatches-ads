2px;padding:14px;background:var(--fp-accent-soft);flex-direction:column;gap:4px;text-align:center}\n  #fp-offer-{{ product.id }} .fp-order__success:not([hidden]){display:flex}\n  #fp-offer-{{ product.id }} .fp-order__sel{margin:0 0 12px;padding:10px 12px;border-radius:10px;background:var(--fp-accent-soft);color:var(--fp-accent);font-weight:700;font-size:14px;text-align:center}\n  #fp-offer-{{ product.id }} .fp-contact{display:block;text-align:center;margin-top:16px;border:1.5px solid var(--fp-accent-soft);color:var(--fp-accent);font-weight:700;border-radius:12px;padding:14px;text-decoration:none}\n  #fp-offer-{{ product.id }} .fp-auth{display:flex;align-items:center;gap:12px;background:var(--fp-accent-soft);border-radius:14px;padding:12px 14px;margin-top:16px}\n  #fp-offer-{{ product.id }} .fp-auth__img{position:relative;flex:0 0 auto}\n  #fp-offer-{{ product.id }} .fp-auth__ph{width:74px;height:56px;border-radius:10px;border:2px dashed #e3b3ca;display:flex;align-items:center;justify-content:center;font-size:10px;color:#c98bab;text-align:center;background:#fff;line-height:1.2}\n  #fp-offer-{{ product.id }} .fp-auth__count{position:absolute;left:-8px;bottom:-8px;background:var(--fp-accent);color:#fff;font-weight:800;font-size:12px;border-radius:50%;width:34px;height:34px;display:flex;align-items:center;justify-content:center;border:3px solid var(--fp-accent-soft)}\n  #fp-offer-{{ product.id }} .fp-auth__text{margin:0;font-size:14px;line-height:1.35}\n  #fp-offer-{{ product.id }} .fp-obj2{margin-top:18px}\n  #fp-offer-{{ product.id }} .fp-obj2__eyebrow{color:var(--fp-accent);font-weight:800;letter-spacing:1px;font-size:11px;margin:0 0 4px}\n  #fp-offer-{{ product.id }} .fp-obj2__title{font-size:20px;font-weight:800;color:#111;margin:0 0 10px}\n  #fp-offer-{{ product.id }} .fp-obj2__i{border-bottom:1px solid #ececec}\n  #fp-offer-{{ product.id }} .fp-obj2__i summary{list-style:none;cursor:pointer;font-weight:700;font-size:15px;color:#1b1b1b;padding:15px 30px 15px 0;position:relative}\n  #fp-offer-{{ product.id }} .fp-obj2__i summary::-webkit-details-marker{display:none}\n  #fp-offer-{{ product.id }} .fp-obj2__i summary:after{content:\"+\";position:absolute;right:4px;top:13px;font-size:22px;color:var(--fp-accent);font-weight:400}\n  #fp-offer-{{ product.id }} .fp-obj2__i[open] summary:after{content:\"×\"}\n  #fp-offer-{{ product.id }} .fp-obj2__i > div{padding:0 0 16px;color:#555;font-size:14px;line-height:1.6}\n  #fp-offer-{{ product.id }} .fp-obj2__i b{color:#111}\n\n  @media(max-width:600px){\n    #fp-offer-{{ product.id }} .fp-tier{gap:10px;padding:16px 12px;flex-wrap:wrap}\n    #fp-offer-{{ product.id }} .fp-tier__thumbwrap{flex:0 0 46px;width:46px;height:46px}\n    #fp-offer-{{ product.id }} .fp-tier__body{flex:1 1 auto;min-width:0}\n    #fp-offer-{{ product.id }} .fp-tier__name{font-size:15px}\n    #fp-offer-{{ product.id }} .fp-tier__meta{font-size:12px;white-space:normal}\n    #fp-offer-{{ product.id }} .fp-tier__pricecol{flex:1 0 100%;flex-direction:row;flex-wrap:wrap;align-items:baseline;justify-content:flex-start;gap:4px 10px;text-align:left;margin-top:10px}\n    #fp-offer-{{ product.id }} .fp-tier__old,#fp-offer-{{ product.id }} .fp-tier__new,#fp-offer-{{ product.id }} .fp-tier__save{white-space:normal}\n    #fp-offer-{{ product.id }} .fp-tier__new{font-size:17px}\n    #fp-offer-{{ product.id }} .fp-tier__badge{right:12px}\n  }\n</style>\n\n<script>\n(function(){\n  var root = document.getElementById('fp-offer-{{ product.id }}');\n  if(!root) return;\n  var pixelId = root.dataset.pixel, endpoint = root.dataset.endpoint;\n  var contentId = root.dataset.contentId, currency = root.dataset.currency || 'EUR';\n  if (pixelId && typeof window.fbq === 'undefined') {\n    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?\n    n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;\n    n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;\n    t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}\n    (window,document,'script','https://connect.facebook.net/en_US/fbevents.js');\n    window.fbq('init', pixelId);\n  }\n  var radios = root.querySelectorAll('input[name=\"fp-tier-{{ product.id }}\"]');\n  var orderForm = root.querySelector('[data-order-form]');\n  var errEl = root.querySelector('[data-order-err]');\n  var successEl = root.querySelector('[data-order-success]');\n  var priceNew = root.querySelector('[data-price-new]'), priceOld = root.querySelector('[data-price-old]');\n  var selEl = root.querySelector('[data-order-sel]');\n  function selected(){ var r=root.querySelector('input[name=\"fp-tier-{{ product.id }}\"]:checked'); return {packs:parseInt(r.dataset.packs,10),name:r.dataset.name,total:parseFloat(r.dataset.total),compare:parseFloat(r.dataset.compare),variantId:r.dataset.variant}; }\n  function syncUI(){\n    radios.forEach(function(r){ r.closest('.fp-tier').classList.toggle('is-selected', r.checked); });\n    var s=selected();\n    if(priceNew){ priceNew.textContent = s.total.toFixed(2)+' '+currency; }\n    if(priceOld){ priceOld.textContent = (s.compare||s.total*2).toFixed(2)+' '+currency; }\n    if(selEl){ selEl.textContent = 'Избран пакет: ' + s.name + ' · ' + s.total.toFixed(2) + ' ' + currency; }\n  }\n  radios.forEach(function(r){ r.addEventListener('change', syncUI); });\n  syncUI();\n  var MB=['януари','февруари','март','април','май','юни','юли','август','септември','октомври','ноември','декември'];\n  var els=root.querySelectorAll('[data-tl]'), base=new Date();\n  els.forEach(function(el){ var d=new Date(base.getTime()); d.setDate(d.getDate()+parseInt(el.dataset.tl,10)); el.textContent=d.getDate()+' '+MB[d.getMonth()]; });\n  (function(){\n    function fmtCd(){ var now=new Date(); var end=new Date(now.getFullYear(),now.getMonth(),now.getDate()+1,0,0,0,0);\n      var r=end-now; if(r<0){ r=0; } var h=Math.floor(r/3600000),m=Math.floor(r%3600000/60000),sec=Math.floor(r%60000/1000);\n      return (h<10?'0':'')+h+':'+(m<10?'0':'')+m+':'+(sec<10?'0':'')+sec; }\n    function upd(){ var el=document.querySelector('#fp-offer-{{ product.id }} [data-countdown]'); if(el) el.textContent=fmtCd(); }\n    upd(); if(window.__fpCd){ clearInterval(window.__fpCd); } window.__fpCd=setInterval(upd,1000);\n  })();\n  var addBtn=root.querySelector('[data-add-cart]');\n  if(addBtn){ addBtn.addEventListener('click', function(){ var s=selected(); addBtn.disabled=true; var old=addBtn.textContent; addBtn.textContent='Добавяне…';\n    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:[{id:s.variantId,quantity:1}]})})\n    .then(function(r){ return r.json(); })\n    .then(function(){ if(window.fbq){ window.fbq('track','AddToCart',{content_ids:[contentId],content_type:'product',value:s.total,currency:currency,num_items:s.packs}); } addBtn.disabled=false; addBtn.textContent=old; if(window.fpCart){ window.fpCart.open(); } else { window.location.href='/cart'; } })\n    .catch(function(){ addBtn.disabled=false; addBtn.textContent=old; }); }); }\n  if(orderForm){ orderForm.addEventListener('submit', function(e){ e.preventDefault(); errEl.hidden=true;\n    var name=orderForm.querySelector('input[name=\"fp_name\"]').value.trim();\n    var phone=orderForm.querySelector('input[name=\"fp_phone\"]').value.trim();\n    var digits=phone.replace(/[^0-9]/g,'');\n    if(name.length<2){ errEl.textContent='Моля, въведете име.'; errEl.hidden=false; return; }\n    if(digits.length<6){ errEl.textContent='Моля, въведете валиден телефон.'; errEl.hidden=false; return; }\n    var s=selected(); var isTest=/\\btest\\b|\\bтест\\b|notrack/i.test(name);\n    if(!isTest && window.fbq){ window.fbq('track','InitiateCheckout',{value:s.total,currency:currency,content_ids:[contentId],content_name:'FitPatches',content_type:'product',num_items:s.packs}); }\n    var payload={name:name,phone:phone,packs:s.packs,total:s.total,currency:currency,product:contentId,variant_id:s.variantId,page:window.location.href,ts:Date.now()};\n    if(endpoint){ try{ var blob=new Blob([JSON.stringify(payload)],{type:'text/plain;charset=UTF-8'}); if(navigator.sendBeacon){ navigator.sendBeacon(endpoint,blob); } else { fetch(endpoint,{method:'POST',body:JSON.stringify(payload),mode:'no-cors',keepalive:true}); } }catch(err){} }\n    var _sub=orderForm.querySelector('button[type=\"submit\"]'); if(_sub){ _sub.disabled=true; _sub.textContent='Пренасочване…'; }\n    var _pf='checkout[shipping_address][first_name]='+encodeURIComponent(name)+'&checkout[shipping_address][phone]='+encodeURIComponent(phone);\n    fetch('/cart/clear.js',{method:'POST',headers:{'Content-Type':'application/json'}}).then(function(){ return fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:[{id:s.variantId,quantity:1}]})}); }).then(function(){ window.location.href='/checkout?'+_pf; }).catch(function(){ window.location.href='/checkout'; });\n  }); }\n  var _obj=root.querySelectorAll('.fp-obj2__i');\n  _obj.forEach(function(d){ d.addEventListener('toggle',function(){ if(d.open){ _obj.forEach(function(o){ if(o!==d) o.open=false; }); } }); });\n})();\n</script>\n\n{%- comment -%} FitPatches — плъзгаща количка (стил QuitVibe) {%- endcomment -%}\n<div class=\"fpd\" id=\"fpDrawer\" aria-hidden=\"true\">\n  <div class=\"fpd__ov\" data-fpd-close></div>\n  <aside class=\"fpd__panel\" role=\"dialog\" aria-label=\"Количка\">\n    <div class=\"fpd__head\">\n      <span class=\"fpd__logo\">Fit<span>Patches</span></span>\n      <button class=\"fpd__x\" type=\"button\" data-fpd-close aria-label=\"Затвори\">&times;</button>\n    </div>\n    <div class=\"fpd__ship\">\n      <p class=\"fpd__ship-txt\" data-fpd-ship></p>\n      <div class=\"fpd__ship-track\"><span class=\"fpd__ship-fill\" data-fpd-shipfill></span></div>\n    </div>\n    <div class=\"fpd__body\">\n      <div class=\"fpd__items\" data-fpd-items></div>\n      <div class=\"fpd__up\" data-fpd-upsell hidden>\n        <p class=\"fpd__up-h\">Може още да ти хареса</p>\n        <div class=\"fpd__up-card\">\n          <img class=\"fpd__up-img\" src=\"https://cdn.shopify.com/s/files/1/1019/0929/9545/files/fitpatches_2048_no_white_background.png?v=1773008342\" alt=\"\">\n          <div class=\"fpd__up-info\">\n            <span class=\"fpd__up-name\">3 пакета + 1 подарък</span>\n            <span class=\"fpd__up-price\"><s>119.96</s> <b>39.99</b></span>\n          </div>\n          <button class=\"fpd__up-add\" type=\"button\" data-fpd-upadd>Добави</button>\n        </div>\n      </div>\n    </div>\n    <div class=\"fpd__foot\">\n      <div class=\"fpd__tot\">\n        <div class=\"fpd__tot-row\"><span>Крайна сума:</span><b data-fpd-total>0.00</b></div>\n        <div class=\"fpd__tot-row fpd__tot-row--save\" data-fpd-saverow hidden><span>Спестени:</span><b data-fpd-save></b></div>\n      </div>\n      <a class=\"fpd__go\" href=\"/checkout\">Преминаване към плащане</a>\n      <div class=\"fpd__badges\">\n        <span><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"6\" width=\"20\" height=\"12\" rx=\"2\"/><circle cx=\"12\" cy=\"12\" r=\"2.5\"/></svg>Наложен платеж</span>\n        <span><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3l7 3v5.5c0 4.2-3 7.2-7 8.5-4-1.3-7-4.3-7-8.5V6z\"/><path d=\"M9 12l2 2 4-4\"/></svg>60 дни гаранция</span>\n      </div>\n    </div>\n  </aside>\n</div>\n<style>\n  #fpDrawer{--a:#d64d87;--soft:#fbe9f1;position:fixed;inset:0;z-index:99999;visibility:hidden;pointer-events:none}\n  #fpDrawer.is-open{visibility:visible;pointer-events:auto}\n  #fpDrawer .fpd__ov{position:absolute;inset:0;background:rgba(20,10,16,.45);opacity:0;transition:opacity .25s}\n  #fpDrawer.is-open .fpd__ov{opacity:1}\n  #fpDrawer .fpd__panel{position:absolute;top:0;right:0;height:100%;width:410px;max-width:92vw;background:#fff;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .28s cubic-bezier(.4,0,.2,1);box-shadow:-8px 0 30px rgba(0,0,0,.12);font-family:inherit}\n  #fpDrawer.is-open .fpd__panel{transform:translateX(0)}\n  #fpDrawer .fpd__head{display:flex;align-items:center;justify-content:space-between;padding:18px 20px;border-bottom:1px solid #f0e6ec}\n  #fpDrawer .fpd__logo{font-size:22px;font-weight:800;color:#111;letter-spacing:-.5px}\n  #fpDrawer .fpd__logo span{color:var(--a)}\n  #fpDrawer .fpd__x{border:0;background:none;font-size:30px;line-height:1;color:#888;cursor:pointer;padding:0 4px}\n  #fpDrawer .fpd__ship{padding:14px 20px 4px}\n  #fpDrawer .fpd__ship-txt{margin:0 0 8px;font-size:13px;color:#444;text-align:center;font-weight:600}\n  #fpDrawer .fpd__ship-txt b{color:var(--a)}\n  #fpDrawer .fpd__ship-track{height:8px;border-radius:8px;background:#f0e6ec;overflow:hidden}\n  #fpDrawer .fpd__ship-fill{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--a),#e87bab);border-radius:8px;transition:width .3s}\n  #fpDrawer .fpd__body{flex:1;overflow-y:auto;padding:12px 20px}\n  #fpDrawer .fpd__it{display:flex;gap:12px;padding:14px 0;border-bottom:1px solid #f4eef1}\n  #fpDrawer .fpd__it-img{width:64px;height:64px;border-radius:10px;object-fit:contain;background:var(--soft);flex:0 0 64px;padding:4px}\n  #fpDrawer .fpd__it-mid{flex:1;min-width:0}\n  #fpDrawer .fpd__it-name{font-size:14px;font-weight:700;color:#111;line-height:1.25;margin:0 0 8px}\n  #fpDrawer .fpd__qty{display:inline-flex;align-items:center;border:1px solid #e3d3dc;border-radius:20px;overflow:hidden}\n  #fpDrawer .fpd__qty button{border:0;background:none;width:28px;height:28px;font-size:16px;cursor:pointer;color:var(--a);font-weight:700}\n  #fpDrawer .fpd__qty span{min-width:22px;text-align:center;font-size:14px;font-weight:700}\n  #fpDrawer .fpd__it-rm{display:block;margin-top:7px;border:0;background:none;color:#aaa;font-size:12px;text-decoration:underline;cursor:pointer;padding:0}\n  #fpDrawer .fpd__it-price{text-align:right;white-space:nowrap;font-size:14px}\n  #fpDrawer .fpd__it-price s{display:block;color:#b9b9b9;font-size:12px}\n  #fpDrawer .fpd__it-price b{color:#111}\n  #fpDrawer .fpd__empty{text-align:center;color:#999;padding:40px 0;font-size:15px}\n  #fpDrawer .fpd__up{margin-top:8px;background:var(--soft);border-radius:14px;padding:14px}\n  #fpDrawer .fpd__up-h{margin:0 0 10px;font-size:13px;font-weight:800;color:#111}\n  #fpDrawer .fpd__up-card{display:flex;align-items:center;gap:12px}\n  #fpDrawer .fpd__up-img{width:48px;height:48px;object-fit:contain;background:#fff;border-radius:10px;padding:3px;flex:0 0 48px}\n  #fpDrawer .fpd__up-info{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}\n  #fpDrawer .fpd__up-name{font-size:13px;font-weight:700;color:#111}\n  #fpDrawer .fpd__up-price s{color:#b9b9b9;font-size:12px}\n  #fpDrawer .fpd__up-price b{color:var(--a);font-size:14px}\n  #fpDrawer .fpd__up-add{border:0;background:#fff;color:var(--a);border:1.5px solid var(--a);border-radius:20px;padding:8px 16px;font-weight:800;font-size:13px;cursor:pointer}\n  #fpDrawer .fpd__foot{border-top:1px solid #f0e6ec;padding:16px 20px 20px}\n  #fpDrawer .fpd__tot-row{display:flex;justify-content:space-between;align-items:baseline;font-size:15px;margin-bottom:4px}\n  #fpDrawer .fpd__tot-row b{font-size:22px;font-weight:800;color:#111}\n  #fpDrawer .fpd__tot-row--save b{font-size:15px;color:var(--a)}\n  #fpDrawer .fpd__go{display:block;text-align:center;background:var(--a);color:#fff;font-weight:800;font-size:17px;border-radius:14px;padding:16px;text-decoration:none;margin:12px 0 12px}\n  #fpDrawer .fpd__go:active{transform:translateY(1px)}\n  #fpDrawer .fpd__badges{display:flex;justify-content:center;gap:22px}\n  #fpDrawer .fpd__badges span{display:flex;align-items:center;gap:6px;font-size:12px;color:#666;font-weight:600}\n  #fpDrawer .fpd__badges svg{width:18px;height:18px;color:var(--a)}\n  body.fpd-lock{overflow:hidden}\n  @media(max-width:600px){#fpDrawer .fpd__panel{width:100%;max-width:100%}}\n</style>\n<script>\n(function(){\n  var CUR='{{ shop.currency }}', FREESHIP=70, UP_ID='53837385859409';\n  var root=document.getElementById('fpDrawer'); if(!root) return;\n  function m(c){ return (c/100).toFixed(2)+' '+CUR; }\n  function esc(s){ return (s||'').replace(/[&<>\"]/g,function(x){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[x];}); }\n  var itemsEl=root.querySelector('[data-fpd-items]');\n  var shipEl=root.querySelector('[data-fpd-ship]'), fillEl=root.querySelector('[data-fpd-shipfill]');\n  var totEl=root.querySelector('[data-fpd-total]'), saveRow=root.querySelector('[data-fpd-saverow]'), saveEl=root.querySelector('[data-fpd-save]');\n  var upEl=root.querySelector('[data-fpd-upsell]'), goEl=root.querySelector('.fpd__go');\n  function render(cart){\n    var items=cart.items||[];\n    if(!items.length){ itemsEl.innerHTML='<p class=\"fpd__empty\">Количката е празна.</p>'; }\n    else {\n      itemsEl.innerHTML=items.map(function(it){\n        var cmp=(it.compare_at_price && it.compare_at_price>it.final_price)?('<s>'+m(it.compare_at_price*it.quantity)+'</s>'):'';\n        return '<div class=\"fpd__it\" data-key=\"'+esc(it.key)+'\">'\n          +'<img class=\"fpd__it-img\" src=\"'+(it.image||'')+'\" alt=\"\">'\n          +'<div class=\"fpd__it-mid\"><p class=\"fpd__it-name\">'+esc(it.product_title)+'</p>'\n          +'<div class=\"fpd__qty\"><button type=\"button\" data-dec>&minus;</button><span>'+it.quantity+'</span><button type=\"button\" data-inc>+</button></div>'\n          +'<button type=\"button\" class=\"fpd__it-rm\" data-rm>Премахни</button></div>'\n          +'<div class=\"fpd__it-price\">'+cmp+'<b>'+m(it.final_line_price)+'</b></div></div>';\n      }).join('');\n    }\n    var total=cart.total_price/100;\n    totEl.textContent=m(cart.total_price);\n    var save=0; items.forEach(function(it){ if(it.compare_at_price && it.compare_at_price>it.final_price){ save+=(it.compare_at_price-it.final_price)*it.quantity; } });\n    if(save>0){ saveRow.hidden=false; saveEl.textContent='-'+m(save); } else { saveRow.hidden=true; }\n    var rem=FREESHIP-total;\n    if(rem>0){ shipEl.innerHTML='Остават <b>'+rem.toFixed(2)+' '+CUR+'</b> до безплатна доставка'; fillEl.style.width=Math.min(100,total/FREESHIP*100)+'%'; }\n    else { shipEl.innerHTML='🎉 Имаш <b>безплатна доставка</b>!'; fillEl.style.width='100%'; }\n    var hasUp=items.some(function(it){ return String(it.variant_id)===UP_ID; });\n    upEl.hidden = (hasUp || !items.length);\n    goEl.style.pointerEvents=items.length?'auto':'none';\n    goEl.style.opacity=items.length?'1':'.5';\n  }\n  function refresh(){ return fetch('/cart.js',{headers:{'Accept':'application/json'}}).then(function(r){return r.json();}).then(render); }\n  function change(key,q){ return fetch('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({id:key,quantity:q})}).then(function(r){return r.json();}).then(render); }\n  itemsEl.addEventListener('click',function(e){\n    var row=e.target.closest('.fpd__it'); if(!row) return; var key=row.getAttribute('data-key');\n    var qty=parseInt(row.querySelector('.fpd__qty span').textContent,10);\n    if(e.target.closest('[data-inc]')) change(key,qty+1);\n    else if(e.target.closest('[data-dec]')) change(key,Math.max(0,qty-1));\n    else if(e.target.closest('[data-rm]')) change(key,0);\n  });\n  root.querySelector('[data-fpd-upadd]').addEventListener('click',function(){\n    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:[{id:UP_ID,quantity:1}]})}).then(function(r){return r.json();}).then(refresh);\n  });\n  function open(){ refresh(); root.classList.add('is-open'); root.setAttribute('aria-hidden','false'); document.body.classList.add('fpd-lock'); }\n  function close(){ root.classList.remove('is-open'); root.setAttribute('aria-hidden','true'); document.body.classList.remove('fpd-lock'); }\n  root.querySelectorAll('[data-fpd-close]').forEach(function(b){ b.addEventListener('click',close); });\n  document.addEventListener('keydown',function(e){ if(e.key==='Escape') close(); });\n  window.fpCart={open:open,close:close,refresh:refresh};\n})();\n</script>"
          }
        }
      },
