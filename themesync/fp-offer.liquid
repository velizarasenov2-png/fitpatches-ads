{%- comment -%} FitPatches — Оферта (QuitVibe стил): авторитет, брояч, наличности, бъндъли, бърза поръчка {%- endcomment -%}
{%- liquid
  assign pixel_id = section.settings.pixel_id | default: '1051819453965625'
  assign endpoint = section.settings.cloud_endpoint
  assign phone = section.settings.phone | default: '0887 459 494'
  assign content_id = 'fitpatches'
  assign cur = shop.currency
  assign thumb = product.featured_image
  assign packs_list = '1,2,3' | split: ','
  assign patches_list = '30,60,90' | split: ','
  assign months_list = '1,2,3' | split: ','
  assign perday_list = '0.50,0.42,0.37' | split: ','
  assign freeship_list = 'x,Безплатна доставка,Безплатна доставка' | split: ','
  assign badge_list = 'x,x,Най-популярен' | split: ','
  assign default_tier = 3
-%}

<section class="fp-offer" id="fp-offer-{{ section.id }}"
  data-pixel="{{ pixel_id }}" data-endpoint="{{ endpoint }}"
  data-content-id="{{ content_id }}" data-currency="{{ cur }}">
  <div class="fp-offer__wrap">

    {%- comment -%} Авторитетен банер {%- endcomment -%}
    <div class="fp-auth">
      <div class="fp-auth__img">
        {%- if section.settings.auth_image != blank -%}
          <img src="{{ section.settings.auth_image | image_url: width: 240 }}" alt="Специалисти" loading="lazy">
        {%- else -%}
          <div class="fp-auth__ph">снимка<br>лекари</div>
        {%- endif -%}
        <span class="fp-auth__count">50+</span>
      </div>
      <p class="fp-auth__text">50+ диетолози и специалисти по хранене препоръчват <b>FitPatches</b> на своите клиенти.</p>
    </div>

    {%- comment -%} Бутони действие {%- endcomment -%}
    <p class="fp-see">Може да видиш резултати от FitPatches:</p>
    <div class="fp-action">
      <a href="#shopify-section-fp_img_gif" class="fp-action__btn"><span class="fp-ic-play"></span> ВИЖ В ДЕЙСТВИЕ</a>
      <a href="#shopify-section-fp_img_beforeafter" class="fp-action__btn"><span class="fp-ic-ba"></span> ПРЕДИ И СЛЕД</a>
    </div>

    {%- comment -%} Цена + брояч {%- endcomment -%}
    <div class="fp-price">
      <div class="fp-price__nums">
        <span class="fp-price__old" data-price-old></span>
        <span class="fp-price__new" data-price-new></span>
      </div>
      <div class="fp-count">
        <span class="fp-count__label">-50% ОТСТЪПКА</span>
        <span class="fp-count__time">изтича след <b data-countdown>00:30:00</b></span>
      </div>
    </div>

    {%- comment -%} Ползи с иконки {%- endcomment -%}
    <ul class="fp-benefits">
      <li><span class="fp-bic fp-bic-money"></span><span>Всяко преяждане ти струва фигура и самочувствие. <b>FitPatches ти помага да овладееш глада, без да се измъчваш.</b></span></li>
      <li><span class="fp-bic fp-bic-leaf"></span><span><b>По-малко желание за сладко</b> и нездравословни храни още в първите дни.</span></li>
      <li><span class="fp-bic fp-bic-down"></span><span>Хиляди клиенти усещат <b>по-стабилен апетит през целия ден</b> — без диети и без хапчета.</span></li>
      <li><span class="fp-bic fp-bic-care"></span><span><b>Натурални съставки, без странични ефекти.</b> Една лепенка на ден — толкова е просто.</span></li>
    </ul>

    {%- comment -%} Наличности / срок {%- endcomment -%}
    <div class="fp-timeline">
      <div class="fp-tl__step"><span class="fp-tl__dot fp-tl-cart"></span><span class="fp-tl__d" data-tl="0"></span><small>Поръчано</small></div>
      <div class="fp-tl__bar"></div>
      <div class="fp-tl__step"><span class="fp-tl__dot fp-tl-truck"></span><span class="fp-tl__d" data-tl="1"></span><small>Изпращане</small></div>
      <div class="fp-tl__bar"></div>
      <div class="fp-tl__step"><span class="fp-tl__dot fp-tl-box"></span><span class="fp-tl__d" data-tl="2"></span><small>Доставено</small></div>
    </div>

    {%- comment -%} Бъндъл {%- endcomment -%}
    <h2 class="fp-offer__title">Колко пакета желаете</h2>
    <p class="fp-offer__sub">Повечето клиенти избират 2 или 3 пакета за пълен резултат.</p>

    <div class="fp-offer__tiers" role="radiogroup" aria-label="Изберете пакет">
      {%- for variant in product.variants limit: 3 -%}
        {%- assign i = forloop.index0 -%}
        {%- assign idx = forloop.index -%}
        {%- assign packs = packs_list[i] -%}
        {%- assign patches = patches_list[i] -%}
        {%- assign months = months_list[i] -%}
        {%- assign per_day = perday_list[i] -%}
        {%- assign freeship = freeship_list[i] -%}
        {%- assign badge = badge_list[i] -%}
        {%- assign total = variant.price | divided_by: 100.0 -%}
        {%- assign per_pack = variant.price | divided_by: packs | divided_by: 100.0 -%}
        {%- assign has_compare = false -%}
        {%- if variant.compare_at_price and variant.compare_at_price > variant.price -%}
          {%- assign has_compare = true -%}
          {%- assign old_perpack = variant.compare_at_price | divided_by: packs | divided_by: 100.0 -%}
          {%- assign saved = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price -%}
        {%- endif -%}
        <label class="fp-tier{% if idx == default_tier %} is-selected{% endif %}" data-tier="{{ idx }}">
          <input type="radio" name="fp-tier-{{ section.id }}" value="{{ idx }}" data-packs="{{ packs }}" data-variant="{{ variant.id }}" data-total="{{ total }}"{% if idx == default_tier %} checked{% endif %}>
          {%- unless badge == 'x' -%}<span class="fp-tier__badge">{{ badge }}</span>{%- endunless -%}
          <span class="fp-tier__radio" aria-hidden="true"></span>
          {%- if thumb -%}<img class="fp-tier__thumb" src="{{ thumb | image_url: width: 160 }}" alt="" loading="lazy" width="60" height="60">{%- endif -%}
          <span class="fp-tier__body">
            <span class="fp-tier__name">{{ packs }}{% if packs == '1' %} пакет{% else %} пакета{% endif %}</span>
            <span class="fp-tier__meta">{{ patches }} лепенки · {{ months }}{% if months == '1' %} месец{% else %} месеца{% endif %}</span>
            {%- unless freeship == 'x' -%}<span class="fp-tier__ship">{{ freeship }}</span>{%- endunless -%}
          </span>
          <span class="fp-tier__pricecol">
            {%- if has_compare -%}<span class="fp-tier__old">{{ old_perpack }} {{ cur }}/пакет</span>{%- endif -%}
            <span class="fp-tier__new">{{ per_pack }} {{ cur }}/пакет</span>
            {%- if has_compare -%}<span class="fp-tier__save">Спестяваш {{ saved }}%</span>{%- endif -%}
            <span class="fp-tier__perday">{{ per_day }} {{ cur }} на ден</span>
          </span>
        </label>
      {%- endfor -%}
    </div>

    <div class="fp-offer__actions">
      <button type="button" class="fp-btn fp-btn--order" data-open-order>Поръчай с наложен платеж</button>
      <button type="button" class="fp-btn fp-btn--cart" data-add-cart>Добави в количката</button>
    </div>
    <p class="fp-offer__reassure">Плащане при доставка · Доставка до 2–4 работни дни · Без предплащане</p>

    {%- comment -%} Бърза поръчка {%- endcomment -%}
    <div class="fp-quick">
      <strong class="fp-quick__title">Предпочиташ по-лесна поръчка?</strong>
      <p class="fp-quick__lead">Остави име и телефон и ще се свържем с теб за потвърждение на поръчката и адреса.</p>
      <form class="fp-order" data-order-form>
        <div class="fp-order__row"><input type="text" name="fp_name" placeholder="Име" autocomplete="name" required></div>
        <div class="fp-order__row"><input type="tel" name="fp_phone" placeholder="Телефон (0888 123 456)" autocomplete="tel" inputmode="tel" required></div>
        <div class="fp-order__summary" data-order-summary></div>
        <button type="submit" class="fp-btn fp-btn--submit">Изпрати заявка</button>
        <p class="fp-order__err" data-order-err hidden></p>
      </form>
      <div class="fp-order__success" data-order-success hidden>
        <strong>Благодарим! Поръчката е приета.</strong>
        <span>Ще Ви се обадим скоро за потвърждение.</span>
      </div>
    </div>

    <a class="fp-contact" href="tel:{{ phone | remove: ' ' }}">Имате въпроси? Свържете се с нас на {{ phone }}</a>
  </div>
</section>

<style>
  #fp-offer-{{ section.id }}{--fp-accent:#1e874b;--fp-accent-soft:#e8f5ee;--fp-warm:#f6efe6;--fp-orange:#f39a2b;--fp-red:#e23b3b}
  #fp-offer-{{ section.id }} .fp-offer__wrap{max-width:640px;margin:0 auto;padding:20px 16px;font-size:15px;color:#1b1b1b}
  #fp-offer-{{ section.id }} b{color:#111}
  #fp-offer-{{ section.id }} .fp-auth{display:flex;align-items:center;gap:12px;background:var(--fp-accent-soft);border-radius:14px;padding:12px 14px;margin-bottom:16px}
  #fp-offer-{{ section.id }} .fp-auth__img{position:relative;flex:0 0 auto}
  #fp-offer-{{ section.id }} .fp-auth__img img,#fp-offer-{{ section.id }} .fp-auth__ph{width:74px;height:56px;border-radius:10px;object-fit:cover}
  #fp-offer-{{ section.id }} .fp-auth__ph{border:2px dashed #b9d4c4;display:flex;align-items:center;justify-content:center;font-size:10px;color:#7fa791;text-align:center;background:#fff;line-height:1.2}
  #fp-offer-{{ section.id }} .fp-auth__count{position:absolute;left:-8px;bottom:-8px;background:var(--fp-accent);color:#fff;font-weight:800;font-size:12px;border-radius:50%;width:34px;height:34px;display:flex;align-items:center;justify-content:center;border:3px solid var(--fp-accent-soft)}
  #fp-offer-{{ section.id }} .fp-auth__text{margin:0;font-size:14px;line-height:1.35}
  #fp-offer-{{ section.id }} .fp-see{text-align:center;color:#777;font-size:13px;margin:0 0 8px}
  #fp-offer-{{ section.id }} .fp-action{display:flex;gap:10px;margin-bottom:18px}
  #fp-offer-{{ section.id }} .fp-action__btn{flex:1;display:flex;align-items:center;justify-content:center;gap:8px;background:var(--fp-accent-soft);color:var(--fp-accent);font-weight:800;font-size:13px;letter-spacing:.3px;border-radius:12px;padding:13px 8px;text-decoration:none}
  #fp-offer-{{ section.id }} .fp-ic-play,#fp-offer-{{ section.id }} .fp-ic-ba{width:16px;height:16px;display:inline-block;background:var(--fp-accent);border-radius:4px}
  #fp-offer-{{ section.id }} .fp-ic-play{clip-path:polygon(20% 10%,20% 90%,90% 50%)}
  #fp-offer-{{ section.id }} .fp-price{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:16px}
  #fp-offer-{{ section.id }} .fp-price__old{color:#b0b0b0;text-decoration:line-through;font-size:20px;margin-right:8px}
  #fp-offer-{{ section.id }} .fp-price__new{color:var(--fp-accent);font-size:26px;font-weight:800}
  #fp-offer-{{ section.id }} .fp-count{background:#e23b3b;color:#fff;border-radius:10px;padding:8px 12px;text-align:center;line-height:1.2}
  #fp-offer-{{ section.id }} .fp-count__label{display:block;font-weight:800;font-size:13px}
  #fp-offer-{{ section.id }} .fp-count__time{font-size:12px}
  #fp-offer-{{ section.id }} .fp-benefits{list-style:none;margin:0 0 18px;padding:0;display:flex;flex-direction:column;gap:14px}
  #fp-offer-{{ section.id }} .fp-benefits li{display:flex;gap:12px;align-items:flex-start;font-size:14px;line-height:1.4}
  #fp-offer-{{ section.id }} .fp-bic{flex:0 0 38px;width:38px;height:38px;border-radius:50%;background:var(--fp-accent-soft);position:relative}
  #fp-offer-{{ section.id }} .fp-bic:after{content:"";position:absolute;inset:10px;background:var(--fp-accent);border-radius:4px;opacity:.85}
  #fp-offer-{{ section.id }} .fp-bic-down:after{clip-path:polygon(50% 100%,0 40%,35% 40%,35% 0,65% 0,65% 40%,100% 40%)}
  #fp-offer-{{ section.id }} .fp-bic-leaf:after{border-radius:0 16px 0 16px}
  #fp-offer-{{ section.id }} .fp-timeline{display:flex;align-items:center;justify-content:space-between;background:#fff;border:1px solid #eee;border-radius:14px;padding:14px 12px;margin-bottom:20px}
  #fp-offer-{{ section.id }} .fp-tl__step{display:flex;flex-direction:column;align-items:center;gap:4px;flex:0 0 auto;text-align:center}
  #fp-offer-{{ section.id }} .fp-tl__step small{color:#333;font-weight:700;font-size:12px}
  #fp-offer-{{ section.id }} .fp-tl__d{font-size:12px;color:#7a7a7a}
  #fp-offer-{{ section.id }} .fp-tl__dot{width:40px;height:40px;border-radius:50%;background:var(--fp-accent-soft);position:relative}
  #fp-offer-{{ section.id }} .fp-tl__dot:after{content:"";position:absolute;inset:11px;background:var(--fp-accent);border-radius:4px}
  #fp-offer-{{ section.id }} .fp-tl__bar{flex:1;height:2px;background:var(--fp-accent);margin:0 4px;align-self:flex-start;margin-top:19px}
  #fp-offer-{{ section.id }} .fp-offer__title{font-size:22px;font-weight:800;text-align:center;margin:0 0 4px}
  #fp-offer-{{ section.id }} .fp-offer__sub{text-align:center;color:#666;margin:0 0 16px;font-size:14px}
  #fp-offer-{{ section.id }} .fp-offer__tiers{display:flex;flex-direction:column;gap:12px}
  #fp-offer-{{ section.id }} .fp-tier{position:relative;display:flex;align-items:center;gap:12px;border:2px solid #e3e3e3;border-radius:14px;padding:14px;cursor:pointer;background:#fff;transition:border-color .15s,box-shadow .15s}
  #fp-offer-{{ section.id }} .fp-tier.is-selected{border-color:var(--fp-accent);box-shadow:0 0 0 3px var(--fp-accent-soft)}
  #fp-offer-{{ section.id }} .fp-tier input{position:absolute;opacity:0;pointer-events:none}
  #fp-offer-{{ section.id }} .fp-tier__radio{flex:0 0 22px;width:22px;height:22px;border:2px solid #cfcfcf;border-radius:50%;position:relative}
  #fp-offer-{{ section.id }} .fp-tier.is-selected .fp-tier__radio{border-color:var(--fp-accent)}
  #fp-offer-{{ section.id }} .fp-tier.is-selected .fp-tier__radio:after{content:"";position:absolute;inset:4px;border-radius:50%;background:var(--fp-accent)}
  #fp-offer-{{ section.id }} .fp-tier__thumb{flex:0 0 56px;width:56px;height:56px;border-radius:10px;object-fit:contain;background:var(--fp-warm)}
  #fp-offer-{{ section.id }} .fp-tier__body{display:flex;flex-direction:column;gap:2px;flex:1;min-width:0}
  #fp-offer-{{ section.id }} .fp-tier__name{font-weight:800;font-size:16px}
  #fp-offer-{{ section.id }} .fp-tier__meta{color:#777;font-size:12px}
  #fp-offer-{{ section.id }} .fp-tier__ship{display:inline-block;width:fit-content;margin-top:3px;background:#eef7f1;color:var(--fp-accent);font-size:11px;font-weight:700;padding:2px 8px;border-radius:6px}
  #fp-offer-{{ section.id }} .fp-tier__pricecol{display:flex;flex-direction:column;align-items:flex-end;text-align:right;flex:0 0 auto}
  #fp-offer-{{ section.id }} .fp-tier__old{color:#e23b3b;text-decoration:line-through;font-size:12px}
  #fp-offer-{{ section.id }} .fp-tier__new{font-weight:800;font-size:16px;color:#111}
  #fp-offer-{{ section.id }} .fp-tier__save{color:var(--fp-accent);font-weight:700;font-size:12px}
  #fp-offer-{{ section.id }} .fp-tier__perday{color:#a0a0a0;font-size:11px}
  #fp-offer-{{ section.id }} .fp-tier__badge{position:absolute;top:-11px;right:16px;background:var(--fp-accent);color:#fff;font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px}
  #fp-offer-{{ section.id }} .fp-offer__actions{display:flex;flex-direction:column;gap:10px;margin-top:18px}
  #fp-offer-{{ section.id }} .fp-btn{border:0;border-radius:12px;padding:15px 18px;font-size:16px;font-weight:800;cursor:pointer;width:100%}
  #fp-offer-{{ section.id }} .fp-btn:active{transform:translateY(1px)}
  #fp-offer-{{ section.id }} .fp-btn--order{background:#f39a2b;color:#fff}
  #fp-offer-{{ section.id }} .fp-btn--cart{background:#fff;color:#222;border:2px solid #ddd}
  #fp-offer-{{ section.id }} .fp-btn--submit{background:#f39a2b;color:#fff}
  #fp-offer-{{ section.id }} .fp-offer__reassure{text-align:center;color:#888;font-size:12px;margin:12px 0 0}
  #fp-offer-{{ section.id }} .fp-quick{margin-top:22px;border:2px solid #f5e2c7;background:#fffaf2;border-radius:16px;padding:18px}
  #fp-offer-{{ section.id }} .fp-quick__title{color:#f39a2b;font-size:18px;display:block;margin-bottom:4px}
  #fp-offer-{{ section.id }} .fp-quick__lead{margin:0 0 12px;font-size:14px;color:#555}
  #fp-offer-{{ section.id }} .fp-order__row{margin-bottom:10px}
  #fp-offer-{{ section.id }} .fp-order input{width:100%;padding:14px;border:1.5px solid #e0d3bd;border-radius:10px;font-size:16px;background:#fff}
  #fp-offer-{{ section.id }} .fp-order input:focus{outline:none;border-color:#f39a2b}
  #fp-offer-{{ section.id }} .fp-order__summary{font-size:14px;color:#333;margin:4px 0 8px;font-weight:600}
  #fp-offer-{{ section.id }} .fp-order__err{color:#c0392b;font-size:13px;margin:8px 0 0}
  #fp-offer-{{ section.id }} .fp-order__success{margin-top:8px;border:2px solid var(--fp-accent);border-radius:12px;padding:14px;background:var(--fp-accent-soft);display:flex;flex-direction:column;gap:4px;text-align:center}
  #fp-offer-{{ section.id }} .fp-contact{display:block;text-align:center;margin-top:16px;border:1.5px solid var(--fp-accent-soft);color:var(--fp-accent);font-weight:700;border-radius:12px;padding:14px;text-decoration:none}
</style>

<script>
(function(){
  var root = document.getElementById('fp-offer-{{ section.id }}');
  if(!root) return;
  var pixelId = root.dataset.pixel, endpoint = root.dataset.endpoint;
  var contentId = root.dataset.contentId, currency = root.dataset.currency || 'EUR';
  if (pixelId && typeof window.fbq === 'undefined') {
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
    n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}
    (window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    window.fbq('init', pixelId);
  }
  var radios = root.querySelectorAll('input[name="fp-tier-{{ section.id }}"]');
  var orderForm = root.querySelector('[data-order-form]');
  var summary = root.querySelector('[data-order-summary]');
  var errEl = root.querySelector('[data-order-err]');
  var successEl = root.querySelector('[data-order-success]');
  var priceNew = root.querySelector('[data-price-new]'), priceOld = root.querySelector('[data-price-old]');
  function selected(){ var r=root.querySelector('input[name="fp-tier-{{ section.id }}"]:checked'); return {packs:parseInt(r.dataset.packs,10),total:parseFloat(r.dataset.total),variantId:r.dataset.variant}; }
  function syncUI(){
    radios.forEach(function(r){ r.closest('.fp-tier').classList.toggle('is-selected', r.checked); });
    var s=selected();
    if(summary){ summary.textContent = s.packs + (s.packs===1?' пакет':' пакета') + ' · ' + s.total.toFixed(2) + ' ' + currency + ' с доставка'; }
    if(priceNew){ priceNew.textContent = s.total.toFixed(2)+' '+currency; }
    if(priceOld){ priceOld.textContent = (s.total*2).toFixed(2)+' '+currency; }
  }
  radios.forEach(function(r){ r.addEventListener('change', syncUI); });
  syncUI();

  // Наличности дати (bg)
  var MB=['януари','февруари','март','април','май','юни','юли','август','септември','октомври','ноември','декември'];
  var els=root.querySelectorAll('[data-tl]'), base=new Date();
  els.forEach(function(el){ var d=new Date(base.getTime()); d.setDate(d.getDate()+parseInt(el.dataset.tl,10)); el.textContent=d.getDate()+' '+MB[d.getMonth()]; });

  // Брояч 30 мин, пази в localStorage
  var cd=root.querySelector('[data-countdown]');
  if(cd){
    var KEY='fp_cd_{{ section.id }}', dur=30*60*1000, now=Date.now();
    var end=parseInt(localStorage.getItem(KEY),10);
    if(!end || end<now){ end=now+dur; localStorage.setItem(KEY,end); }
    function tick(){ var r=end-Date.now(); if(r<0){ r=0; } var h=Math.floor(r/3600000),m=Math.floor(r%3600000/60000),sec=Math.floor(r%60000/1000);
      cd.textContent=(h<10?'0':'')+h+':'+(m<10?'0':'')+m+':'+(sec<10?'0':'')+sec; if(r>0) setTimeout(tick,1000); }
    tick();
  }

  var addBtn=root.querySelector('[data-add-cart]');
  if(addBtn){ addBtn.addEventListener('click', function(){ var s=selected(); addBtn.disabled=true; var old=addBtn.textContent; addBtn.textContent='Добавяне…';
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:s.variantId,quantity:1})})
    .then(function(){ if(window.fbq){ window.fbq('track','AddToCart',{content_ids:[contentId],content_type:'product',value:s.total,currency:currency,num_items:s.packs}); } window.location.href='/cart'; })
    .catch(function(){ addBtn.disabled=false; addBtn.textContent=old; }); }); }

  var openBtn=root.querySelector('[data-open-order]');
  if(openBtn){ openBtn.addEventListener('click', function(){ var q=root.querySelector('.fp-quick'); q.scrollIntoView({behavior:'smooth',block:'center'}); var f=q.querySelector('input[name="fp_name"]'); if(f) f.focus(); }); }

  if(orderForm){ orderForm.addEventListener('submit', function(e){ e.preventDefault(); errEl.hidden=true;
    var name=orderForm.querySelector('input[name="fp_name"]').value.trim();
    var phone=orderForm.querySelector('input[name="fp_phone"]').value.trim();
    var digits=phone.replace(/[^0-9]/g,'');
    if(name.length<2){ errEl.textContent='Моля, въведете име.'; errEl.hidden=false; return; }
    if(digits.length<6){ errEl.textContent='Моля, въведете валиден телефон.'; errEl.hidden=false; return; }
    var s=selected(); var isTest=/\btest\b|\bтест\b|notrack/i.test(name);
    if(!isTest && window.fbq){ window.fbq('track','Purchase',{value:s.total,currency:currency,content_ids:[contentId],content_name:'FitPatches',content_type:'product',num_items:s.packs}); }
    var payload={name:name,phone:phone,packs:s.packs,total:s.total,currency:currency,product:contentId,variant_id:s.variantId,page:window.location.href,ts:Date.now()};
    if(endpoint){ try{ var blob=new Blob([JSON.stringify(payload)],{type:'text/plain;charset=UTF-8'}); if(navigator.sendBeacon){ navigator.sendBeacon(endpoint,blob); } else { fetch(endpoint,{method:'POST',body:JSON.stringify(payload),mode:'no-cors',keepalive:true}); } }catch(err){} }
    try{ fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:s.variantId,quantity:1,properties:{'Бърза поръчка':name+' / '+phone}}),keepalive:true}); }catch(err){}
    orderForm.hidden=true; successEl.hidden=false; successEl.scrollIntoView({behavior:'smooth',block:'center'});
  }); }
})();
</script>

