<div class="fpc">
  <h2 class="fpc-title">
    {{- section.settings.title | escape -}}
    {%- if section.settings.show_count and section.blocks.size > 0 %} ({{ section.blocks.size }}){% endif -%}
  </h2>
  <div class="fpc-box">
    {%- if section.blocks.size == 0 -%}
      <p class="fpc-empty">Добавете коментар от менюто вляво: „Добавяне на блок“ → „Коментар“.</p>
    {%- else -%}
      <div class="fpc-list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign s = block.settings
            assign is_reply = s.reply
            if forloop.first
              assign is_reply = false
            endif
            assign author = s.author
            assign avatar = s.avatar
            if s.from_store
              assign author = section.settings.store_name
              assign avatar = section.settings.store_logo
            endif
          -%}
          {%- unless is_reply -%}
            {%- unless forloop.first -%}</div>{%- endunless -%}
            <div class="fpc-thread">
          {%- endunless -%}
          <div class="fpc-c{% if is_reply %} fpc-reply{% endif %}" {{ block.shopify_attributes }}>
            {%- if avatar != blank -%}
              {{ avatar | image_url: width: 80, height: 80, crop: 'center' | image_tag: class: 'fpc-av', loading: 'lazy', alt: author }}
            {%- else -%}
              <span class="fpc-av" aria-hidden="true"></span>
            {%- endif -%}
            <div class="fpc-body">
              <div class="fpc-bubble">
                <p class="fpc-name">{{ author | escape }}</p>
                {%- if s.text != blank -%}
                  <p class="fpc-text">{{ s.text | escape | newline_to_br }}</p>
                {%- endif -%}
              </div>
              {%- if s.photo != blank -%}
                {{ s.photo | image_url: width: 560 | image_tag: class: 'fpc-photo', loading: 'lazy', sizes: '260px', alt: s.photo.alt }}
              {%- endif -%}
              <div class="fpc-meta">
                {%- if s.time != blank %}<span>{{ s.time | escape }}</span>{% endif -%}
                <b>Харесвам</b>
                <b>Отговор</b>
                {%- if s.reactions > 0 -%}
                  <span class="fpc-rx">
                    <span class="fpc-rx-icons">
                      {%- if s.r_like %}<span class="fpc-r fpc-r-like"></span>{% endif -%}
                      {%- if s.r_love %}<span class="fpc-r fpc-r-love"></span>{% endif -%}
                      {%- if s.r_haha %}<span class="fpc-r fpc-r-haha"></span>{% endif -%}
                      {%- if s.r_wow %}<span class="fpc-r fpc-r-wow"></span>{% endif -%}
                    </span>
                    <span>{{ s.reactions }}</span>
                  </span>
                {%- endif -%}
              </div>
            </div>
            {%- if is_reply %}<span class="fpc-curve" aria-hidden="true"></span>{% endif -%}
          </div>
          {%- if forloop.last -%}</div>{%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Коментари (FB стил)",
  "tag": "section",
  "class": "fpc-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Заглавие", "default": "Коментари" },
    { "type": "checkbox", "id": "show_count", "label": "Показвай броя коментари", "default": true },
    { "type": "range", "id": "max_width", "label": "Максимална ширина", "min": 400, "max": 900, "step": 20, "unit": "px", "default": 600 },
    { "type": "header", "content": "Отговори от магазина" },
    { "type": "text", "id": "store_name", "label": "Име на магазина", "default": "FitPatches" },
    { "type": "image_picker", "id": "store_logo", "label": "Лого на магазина" }
  ],
  "blocks": [
    {
      "type": "comment",
      "name": "Коментар",
      "settings": [
        { "type": "paragraph", "content": "Само истински отзиви, с разрешение на клиента за име и снимка." },
        { "type": "checkbox", "id": "from_store", "label": "Отговор от магазина", "info": "Името и логото се взимат от настройките на секцията.", "default": false },
        { "type": "text", "id": "author", "label": "Име на клиента" },
        { "type": "image_picker", "id": "avatar", "label": "Профилна снимка", "info": "Празно = сив силует." },
        { "type": "textarea", "id": "text", "label": "Текст на коментара" },
        { "type": "image_picker", "id": "photo", "label": "Снимка от клиента" },
        { "type": "text", "id": "time", "label": "Кога", "placeholder": "2 седм." },
        { "type": "checkbox", "id": "reply", "label": "Отговор на коментара отгоре", "default": false },
