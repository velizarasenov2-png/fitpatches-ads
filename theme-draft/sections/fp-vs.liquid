{%- comment -%} FitPatches — сравнение срещу диети и хапчета {%- endcomment -%}
{%- assign rows = 'Без глад и лишения,Действа през целия ден,Без хапчета за гълтане,Натурални съставки,Без йо-йо ефект,Лесно за прилагане' | split: ',' -%}
{%- assign fp = '1,1,1,1,1,1' | split: ',' -%}
{%- assign other = '0,0,0,0,0,0' | split: ',' -%}
<section class="fp-vs" id="fpv-{{ section.id }}">
  <div class="fp-vs__wrap">
    <h2 class="fp-vs__title">FitPatches <span>срещу</span> диети и хапчета</h2>
    <table class="fp-vs__table">
      <thead>
        <tr>
          <th class="fp-vs__corner"></th>
          <th class="fp-vs__th fp-vs__th--fp">
            <img src="https://cdn.shopify.com/s/files/1/1019/0929/9545/files/fp-patch-real.png?v=1785852731" alt="FitPatches лепенка" loading="lazy">
            <span>FitPatches</span>
          </th>
          <th class="fp-vs__th">
            <img src="https://cdn.shopify.com/s/files/1/1019/0929/9545/files/fp-nat-pills.png?v=1785854560" alt="Диети и хапчета" loading="lazy">
            <span>Диети / хапчета</span>
          </th>
        </tr>
      </thead>
      <tbody>
        {%- for r in rows -%}
          {%- assign i = forloop.index0 -%}
          <tr>
            <td class="fp-vs__label">{{ r }}</td>
            <td class="fp-vs__c fp-vs__c--fp">
              {%- if fp[i] == '1' -%}<span class="fp-vs__yes">✓</span>{%- else -%}<span class="fp-vs__no">✕</span>{%- endif -%}
            </td>
            <td class="fp-vs__c">
              {%- if other[i] == '1' -%}<span class="fp-vs__yes">✓</span>{%- else -%}<span class="fp-vs__no">✕</span>{%- endif -%}
            </td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  </div>
</section>
<style>
  #fpv-{{ section.id }}{--a:#d64d87;--soft:#fbe9f1}
  #fpv-{{ section.id }} .fp-vs__wrap{max-width:720px;margin:0 auto;padding:48px 18px}
  #fpv-{{ section.id }} .fp-vs__title{text-align:center;font-size:30px;font-weight:800;color:#111;margin:0 0 28px}
  #fpv-{{ section.id }} .fp-vs__title span{color:var(--a)}
  #fpv-{{ section.id }} .fp-vs__table{width:100%;border-collapse:collapse;table-layout:fixed}
  #fpv-{{ section.id }} .fp-vs__corner{width:auto}
  #fpv-{{ section.id }} .fp-vs__th{width:120px;text-align:center;vertical-align:bottom;padding:0 6px 10px}
  #fpv-{{ section.id }} .fp-vs__th img{width:74px;height:74px;border-radius:50%;object-fit:cover;display:block;margin:0 auto 10px;border:3px solid var(--soft)}
  #fpv-{{ section.id }} .fp-vs__th span{display:block;font-weight:800;font-size:14px;color:#999;line-height:1.2}
  #fpv-{{ section.id }} .fp-vs__th--fp span{color:#fff;background:var(--a);border-radius:10px 10px 0 0;padding:10px 6px;margin-top:2px}
  #fpv-{{ section.id }} .fp-vs__table tbody tr{border-top:1px solid #eee}
  #fpv-{{ section.id }} .fp-vs__label{font-size:15px;font-weight:700;color:#111;padding:16px 8px 16px 0}
  #fpv-{{ section.id }} .fp-vs__c{text-align:center;vertical-align:middle;padding:16px 6px}
  #fpv-{{ section.id }} .fp-vs__c--fp{background:var(--soft)}
  #fpv-{{ section.id }} .fp-vs__yes{color:#1aa34a;font-weight:900;font-size:20px}
  #fpv-{{ section.id }} .fp-vs__no{color:#e23b3b;font-weight:900;font-size:18px}
  @media(max-width:749px){
    #fpv-{{ section.id }} .fp-vs__th{width:64px}
    #fpv-{{ section.id }} .fp-vs__th img{width:52px;height:52px}
    #fpv-{{ section.id }} .fp-vs__th span{font-size:12px}
    #fpv-{{ section.id }} .fp-vs__title{font-size:24px}
  }
</style>
{% schema %}
{ "name": "FitPatches Сравнение", "tag": "section", "settings": [], "presets": [ { "name": "FitPatches Сравнение" } ] }
{% endschema %}
