{%- comment -%} FitPatches — Оферта: цена, ползи, бъндъл, бонуси, наличности, бърза поръчка, контакт, авторитет {%- endcomment -%}
{%- liquid
  assign pixel_id = '1051819453965625'
  assign endpoint = ''
  assign phone = '0887 459 494'
  assign content_id = 'fitpatches'
  assign cur = shop.currency
  assign thumb = 'https://cdn.shopify.com/s/files/1/1019/0929/9545/files/fitpatches_2048_no_white_background.png?v=1773008342'
  assign t_names = '1 пакет|2+1 подарък|3+2 подарък' | split: '|'
  assign t_meta = '30 лепенки · за 1 месец|3 пакета · 90 лепенки · за 3 месеца|5 пакета · 150 лепенки · за 5 месеца' | split: '|'
  assign t_gift = 'x|+1 пакет подарък|+2 пакета подарък' | split: '|'
  assign t_packs = '1|3|5' | split: '|'
  assign t_ids = '53836021039441|53837384024401|53837385859409' | split: '|'
  assign t_total = '14.99|27.99|39.99' | split: '|'
  assign t_price = '14,99 €|27,99 €|39,99 €' | split: '|'
  assign t_day = '0,50 €|0,31 €|0,27 €' | split: '|'
  assign t_save = 'x|Спестяваш 16,98 € спрямо 3 единични пакета|Спестяваш 34,96 € спрямо 5 единични пакета' | split: '|'
  assign t_badge = 'x|x|Най-изгодно' | split: '|'
  assign t_prop = 'FitPatches 1 пакет (30 лепенки)|FitPatches 2+1 подарък — 3 пакета (90 лепенки)|FitPatches 3+2 подарък — 5 пакета (150 лепенки)' | split: '|'
  assign default_tier = 3
-%}

<section class="fp-offer" id="fp-offer-{{ product.id }}"
  data-pixel="{{ pixel_id }}" data-endpoint="{{ endpoint }}"
  data-content-id="{{ content_id }}" data-currency="{{ cur }}">
  <div class="fp-offer__wrap">

    {%- comment -%} Цена на избрания пакет + цена на ден {%- endcomment -%}
    <div class="fp-price">
      <div class="fp-price__nums">
        <span class="fp-price__new" data-price-new>{{ t_price[2] }}</span>
        <span class="fp-price__day">само <b data-price-day>{{ t_day[2] }}</b> на ден</span>
      </div>
      <div class="fp-price__chips"><span>Плащане при доставка</span></div>
    </div>

    {%- comment -%} Ползи {%- endcomment -%}
    <ul class="fp-benefits">
      <li><span class="fp-bic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="6.5" rx="7" ry="3"/><path d="M5 6.5v5c0 1.66 3.13 3 7 3s7-1.34 7-3v-5"/><path d="M5 11.5v5c0 1.66 3.13 3 7 3s7-1.34 7-3v-5"/></svg></span><span>Всяко преяждане ти струва фигура и самочувствие. <b>FitPatches ти помага да овладееш глада, без да се измъчваш.</b></span></li>
      <li><span class="fp-bic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20C4 12 10 5 20 4c-1 9-7 16-16 16z"/><path d="M4 20c3-6 7-9.5 12-11.5"/></svg></span><span><b>По-малко желание за сладко</b> и нездравословни храни още в първите дни.</span></li>
      <li><span class="fp-bic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 7 9 13 13 10 21 16"/><polyline points="16 16 21 16 21 11"/></svg></span><span>Хиляди клиенти усещат <b>по-стабилен апетит през целия ден</b> — без диети и без хапчета.</span></li>
      <li><span class="fp-bic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5.5c0 4.2-3 7.2-7 8.5-4-1.3-7-4.3-7-8.5V6z"/><path d="M9 12l2 2 4-4"/></svg></span><span><b>Натурални съставки, без странични ефекти.</b> Една лепенка на ден — толкова е просто.</span></li>
    </ul>

    <div class="fp-divider"></div>

    {%- comment -%} Бъндъл {%- endcomment -%}
    <h2 class="fp-offer__title">Колко пакета желаете?</h2>
    <p class="fp-offer__sub">Колкото повече пакети, толкова по-ниска цена на ден.</p>

    <div class="fp-offer__tiers" role="radiogroup" aria-label="Изберете пакет">
      {%- for name in t_names -%}
        {%- assign i = forloop.index0 -%}
        {%- assign idx = forloop.index -%}
        <label class="fp-tier{% if idx == default_tier %} is-selected{% endif %}{% if t_badge[i] != 'x' %} fp-tier--best{% endif %}" data-tier="{{ idx }}">
          <input type="radio" name="fp-tier-{{ product.id }}" value="{{ idx }}"
            data-packs="{{ t_packs[i] }}" data-name="{{ name }}" data-variant="{{ t_ids[i] }}"
            data-total="{{ t_total[i] }}" data-price="{{ t_price[i] }}" data-day="{{ t_day[i] }}" data-prop="{{ t_prop[i] }}"
            {% if idx == default_tier %}checked{% endif %}>
          {%- if t_badge[i] != 'x' -%}<span class="fp-tier__badge">{{ t_badge[i] }}</span>{%- endif -%}
          <span class="fp-tier__radio" aria-hidden="true"></span>
          <span class="fp-tier__thumbwrap"><img class="fp-tier__thumb" src="{{ thumb }}" alt="" loading="lazy" width="64" height="64"><span class="fp-tier__qty">×{{ t_packs[i] }}</span></span>
          <span class="fp-tier__body">
            <span class="fp-tier__name">{{ name }}</span>
            <span class="fp-tier__meta">{{ t_meta[i] }}</span>
            {%- if t_gift[i] != 'x' -%}
              <span class="fp-tier__gift"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M19 12v9H5v-9"/><path d="M7.5 8a2.5 2.5 0 1 1 0-5C11 3 12 8 12 8s1-5 4.5-5a2.5 2.5 0 1 1 0 5"/></svg>{{ t_gift[i] }}</span>
            {%- endif -%}
          </span>
          <span class="fp-tier__pricecol">
            <span class="fp-tier__new">{{ t_price[i] }}</span>
            <span class="fp-tier__day">{{ t_day[i] }} / ден</span>
          </span>
          {%- if t_save[i] != 'x' -%}<span class="fp-tier__save">{{ t_save[i] }}</span>{%- endif -%}
        </label>
      {%- endfor -%}
    </div>

    <div class="fp-offer__actions">
      <button type="button" class="fp-btn fp-btn--cart" data-add-cart>Поръчай сега</button>
    </div>
    <p class="fp-offer__reassure">Плащане при доставка · Доставка до 2–4 работни дни · Без предплащане</p>

    {%- comment -%} Наличности {%- endcomment -%}
    <div class="fp-timeline">
      <div class="fp-tl__step"><span class="fp-tl__dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.3"/><circle cx="17" cy="20" r="1.3"/><path d="M3 4h2l2.2 11.2a1.5 1.5 0 0 0 1.5 1.2h7.6a1.5 1.5 0 0 0 1.5-1.2L21 8H6"/></svg></span><span class="fp-tl__d" data-tl="0"></span><small>Поръчано</small></div>
      <div class="fp-tl__bar"></div>
      <div class="fp-tl__step"><span class="fp-tl__dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="1.5" y="6" width="12" height="9" rx="1"/><path d="M13.5 9h4l3 3v3h-7z"/><circle cx="6" cy="18" r="1.5"/><circle cx="17.5" cy="18" r="1.5"/></svg></span><span class="fp-tl__d" data-tl="1"></span><small>Изпращане</small></div>
      <div class="fp-tl__bar"></div>
      <div class="fp-tl__step"><span class="fp-tl__dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/></svg></span><span class="fp-tl__d" data-tl="2"></span><small>Доставено</small></div>
    </div>

    {%- comment -%} Бърза поръчка {%- endcomment -%}
    <div class="fp-quick">
      <strong class="fp-quick__title">Предпочиташ по-лесна поръчка?</strong>
      <p class="fp-quick__lead">Остави име и телефон и ще се свържем с теб за потвърждение на поръчката и адреса.</p>
      <div class="fp-order__sel" data-order-sel></div>
      <form class="fp-order" data-order-form>
        <div class="fp-order__row"><input type="text" name="fp_name" placeholder="Име" autocomplete="name" required></div>
        <div class="fp-order__row"><input type="tel" name="fp_phone" placeholder="Телефон (0888 123 456)" autocomplete="tel" inputmode="tel" required></div>
        <input type="text" name="fp_company" class="fp-hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <button type="submit" class="fp-btn fp-btn--submit">Изпрати заявка</button>
        <p class="fp-order__err" data-order-err hidden></p>
      </form>
      <div class="fp-order__success" data-order-success hidden>
        <strong>Благодарим! Поръчката е приета.</strong>
        <span>Ще Ви се обадим скоро за потвърждение.</span>
      </div>
    </div>

    <a class="fp-contact" href="tel:{{ phone | remove: ' ' }}">Имате въпроси? Свържете се с нас на {{ phone }}</a>

    <div class="fp-auth">
      <div class="fp-auth__img"><img src="https://cdn.shopify.com/s/files/1/1019/0929/9545/files/fp-doctor.png?v=1785849764" alt="Диетолог" style="width:74px;height:56px;object-fit:cover;border-radius:10px;display:block"><span class="fp-auth__count">50+</span></div>
      <p class="fp-auth__text">50+ диетолози и специалисти по хранене препоръчват <b>FitPatches</b> на своите клиенти.</p>
    </div>
<div class="fp-obj2"><p class="fp-obj2__eyebrow">ПРЕДИ ДА ПОРЪЧАШ</p><h3 class="fp-obj2__title">Знаем какво си мислиш.</h3><details class="fp-obj2__i" open><summary>„Наистина ли работи? Как лепенка може да свали килограми?"</summary><div>FitPatches не „топи мазнини" с магия. Действа, като <b>намалява апетита и желанието за сладко</b> — така се храниш по-малко, без да се мъчиш. Берберинът се усвоява <b>постепенно през кожата (трансдермално)</b> и заобикаля стомаха, където таблетките губят голяма част от силата си.</div></details><details class="fp-obj2__i"><summary>„Пробвах други лепенки и добавки, но нямаше ефект."</summary><div>Повечето таблетки и добавки имат <b>ниска бионаличност</b> — при т.нар. first-pass метаболизъм в черния дроб голяма част от активното вещество се разгражда, преди да стигне до кръвта. FitPatches доставя берберина <b>трансдермално</b> — директно през кожата, заобикаляйки стомаха и черния дроб. Така до организма достига по-висока и по-стабилна концентрация, която действа върху ензима <b>AMPK</b> и върху апетита. Точно това е разликата спрямо това, което си пробвал/а досега.</div></details><details class="fp-obj2__i"><summary>„Честно казано, звучи ми като измама."</summary><div>Разбираме скептицизма — пазарът е пълен с празни обещания. Затова залагаме на <b>механизъм, а не на магия</b>: берберинът е едно от най-изследваните растителни съединения за метаболитен баланс, с хиляди научни публикации. Той активира ензима <b>AMPK</b> — „метаболитния превключвател" на клетката — който подпомага регулацията на кръвната захар и апетита. FitPatches го доставя <b>трансдермално</b>, за стабилно усвояване през целия ден. Не е чудо — а обяснима биохимия.</div></details><details class="fp-obj2__i"><summary>„Колко бързо ще усетя резултат?"</summary><div>Повечето клиенти усещат <b>по-малко желание за храна още в първите дни</b>. За видима промяна във фигурата дай на организма 4–8 седмици редовна употреба — една лепенка на ден.</div></details><details class="fp-obj2__i"><summary>„Има ли странични ефекти?"</summary><div>Съставките са натурални и добре поносими. При бременност, кърмене или прием на лекарства се консултирай с лекар преди употреба.</div></details><details class="fp-obj2__i"><summary>„А ако на мен не ми подейства?"</summary><div>Точно затова започваш <b>без риск с наложен платеж</b>. Пробвай един пакет — ако не усетиш разлика в апетита, просто не поръчваш пак.</div></details></div>
  </div>
</section>

<style>
  #fp-offer-{{ product.id }}{--fp-accent:#d64d87;--fp-accent-soft:#fbe9f1;--fp-warm:#faf0f4;--fp-red:#e23b3b}
  #fp-offer-{{ product.id }} .fp-offer__wrap{font-family:inherit;max-width:100%;margin:0;padding:6px 0 4px;font-size:16px;color:#1b1b1b}
  #fp-offer-{{ product.id }} b{color:#111;font-weight:700}
  #fp-offer-{{ product.id }} .fp-price{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin:0 0 20px}
  #fp-offer-{{ product.id }} .fp-price__nums{display:flex;flex-direction:column;gap:1px}
  #fp-offer-{{ product.id }} .fp-price__old{color:#222;text-decoration:line-through;font-size:15px}
  #fp-offer-{{ product.id }} .fp-price__new{color:var(--fp-accent);font-size:26px;font-weight:800;line-height:1.1}
  #fp-offer-{{ product.id }} .fp-count{flex:0 0 auto;background:var(--fp-red);color:#fff;border-radius:10px;padding:7px 12px;text-align:center;line-height:1.2}
  #fp-offer-{{ product.id }} .fp-count__label{display:block;font-weight:800;font-size:13px}
  #fp-offer-{{ product.id }} .fp-count__time{font-size:12px}
  #fp-offer-{{ product.id }} .fp-benefits{list-style:none;margin:0 0 20px;padding:0;display:flex;flex-direction:column;gap:18px}
  #fp-offer-{{ product.id }} .fp-benefits li{display:flex;gap:14px;align-items:flex-start;font-size:15px;line-height:1.5}
  #fp-offer-{{ product.id }} .fp-bic{flex:0 0 44px;width:44px;height:44px;border-radius:50%;background:var(--fp-accent-soft);color:var(--fp-accent);display:flex;align-items:center;justify-content:center}
  #fp-offer-{{ product.id }} .fp-bic svg{width:22px;height:22px}
  #fp-offer-{{ product.id }} .fp-divider{height:3px;border-radius:3px;background:linear-gradient(90deg,var(--fp-accent) 0,var(--fp-accent) 60%,#eee 60%,#eee 100%);margin:4px 0 18px}
  #fp-offer-{{ product.id }} .fp-offer__title{font-family:inherit;font-size:26px;font-weight:800;margin:0 0 6px;color:#111}
  #fp-offer-{{ product.id }} .fp-offer__sub{color:#666;margin:0 0 18px;font-size:14px}
  #fp-offer-{{ product.id }} .fp-offer__tiers{display:flex;flex-direction:column;gap:14px}
  #fp-offer-{{ product.id }} .fp-tier{position:relative;display:flex;align-items:center;gap:14px;border:2px solid #ececec;border-radius:18px;padding:20px 16px;cursor:pointer;background:#fff;transition:border-color .15s,box-shadow .15s}
  #fp-offer-{{ product.id }} .fp-tier.is-selected{border-color:var(--fp-accent);box-shadow:0 0 0 3px var(--fp-accent-soft)}
  #fp-offer-{{ product.id }} .fp-tier input{position:absolute;opacity:0;pointer-events:none}
  #fp-offer-{{ product.id }} .fp-tier__radio{flex:0 0 22px;width:22px;height:22px;border:2px solid #cfcfcf;border-radius:50%;position:relative}
  #fp-offer-{{ product.id }} .fp-tier.is-selected .fp-tier__radio{border-color:var(--fp-accent)}
  #fp-offer-{{ product.id }} .fp-tier.is-selected .fp-tier__radio:after{content:"";position:absolute;inset:4px;border-radius:50%;background:var(--fp-accent)}
  #fp-offer-{{ product.id }} .fp-tier__thumbwrap{flex:0 0 64px;width:64px;height:64px;border-radius:12px;background:var(--fp-warm);display:flex;align-items:center;justify-content:center;padding:6px}
  #fp-offer-{{ product.id }} .fp-tier__thumb{max-width:100%;max-height:100%;object-fit:contain}
  #fp-offer-{{ product.id }} .fp-tier__body{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;gap:3px}
  #fp-offer-{{ product.id }} .fp-tier__name{font-weight:800;font-size:17px;line-height:1.2}
  #fp-offer-{{ product.id }} .fp-tier__meta{color:#8a8a8a;font-size:13px}
  #fp-offer-{{ product.id }} .fp-tier__pricecol{flex:0 0 auto;display:flex;flex-direction:column;align-items:flex-end;text-align:right;gap:1px}
  #fp-offer-{{ product.id }} .fp-tier__old{color:#222;text-decoration:line-through;font-size:12px;white-space:nowrap}
  #fp-offer-{{ product.id }} .fp-tier__new{font-weight:800;font-size:18px;color:#111;line-height:1.15;white-space:nowrap}
  #fp-offer-{{ product.id }} .fp-tier__save{color:var(--fp-accent);font-weight:700;font-size:12px;white-space:nowrap}
  #fp-offer-{{ product.id }} .fp-tier__badge{position:absolute;top:-11px;right:16px;background:var(--fp-accent);color:#fff;font-size:11px;font-weight:700;padding:4px 11px;border-radius:20px}
  #fp-offer-{{ product.id }} .fp-offer__actions{margin-top:18px}
  #fp-offer-{{ product.id }} .fp-btn{border:0;border-radius:14px;padding:19px 20px;font-size:19px;font-weight:800;cursor:pointer;width:100%;font-family:inherit}
  #fp-offer-{{ product.id }} .fp-btn:active{transform:translateY(1px)}
  #fp-offer-{{ product.id }} .fp-btn--cart{background:var(--fp-accent);color:#fff}
  #fp-offer-{{ product.id }} .fp-btn--submit{background:var(--fp-accent);color:#fff}
  #fp-offer-{{ product.id }} .fp-offer__reassure{text-align:center;color:#888;font-size:12px;margin:12px 0 0}
  #fp-offer-{{ product.id }} .fp-timeline{display:flex;align-items:flex-start;justify-content:space-between;background:#fff;border:1px solid #eee;border-radius:14px;padding:14px 12px;margin:20px 0}
  #fp-offer-{{ product.id }} .fp-tl__step{display:flex;flex-direction:column;align-items:center;gap:4px;flex:0 0 auto;text-align:center}
  #fp-offer-{{ product.id }} .fp-tl__step small{color:#333;font-weight:700;font-size:12px}
  #fp-offer-{{ product.id }} .fp-tl__d{font-size:12px;color:#7a7a7a}
  #fp-offer-{{ product.id }} .fp-tl__dot{width:40px;height:40px;border-radius:50%;background:var(--fp-accent-soft);color:var(--fp-accent);display:flex;align-items:center;justify-content:center}
  #fp-offer-{{ product.id }} .fp-tl__dot svg{width:20px;height:20px}
  #fp-offer-{{ product.id }} .fp-tl__bar{flex:1;height:2px;background:var(--fp-accent);margin:18px 4px 0}
  #fp-offer-{{ product.id }} .fp-quick{margin-top:6px;border:2px solid #f6cfe1;background:#fff6fb;border-radius:16px;padding:18px}
  #fp-offer-{{ product.id }} .fp-quick__title{color:var(--fp-accent);font-size:18px;display:block;margin-bottom:4px}
  #fp-offer-{{ product.id }} .fp-quick__lead{margin:0 0 12px;font-size:14px;color:#555}
  #fp-offer-{{ product.id }} .fp-order__row{margin-bottom:10px}
  #fp-offer-{{ product.id }} .fp-order input{width:100%;padding:14px;border:1.5px solid #edc9db;border-radius:10px;font-size:16px;background:#fff;font-family:inherit}
  #fp-offer-{{ product.id }} .fp-order input:focus{outline:none;border-color:var(--fp-accent)}
  #fp-offer-{{ product.id }} .fp-order__err{color:#c0392b;font-size:13px;margin:8px 0 0}
  #fp-offer-{{ product.id }} .fp-order__success{display:none;margin-top:8px;border:2px solid var(--fp-accent);border-radius:12px;padding:14px;background:var(--fp-accent-soft);flex-direction:column;gap:4px;text-align:center}
  #fp-offer-{{ product.id }} .fp-order__success:not([hidden]){display:flex}
  #fp-offer-{{ product.id }} .fp-order__sel{margin:0 0 12px;padding:10px 12px;border-radius:10px;background:var(--fp-accent-soft);color:var(--fp-accent);font-weight:700;font-size:14px;text-align:center}
  #fp-offer-{{ product.id }} .fp-contact{display:block;text-align:center;margin-top:16px;border:1.5px solid var(--fp-accent-soft);color:var(--fp-accent);font-weight:700;border-radius:12px;padding:14px;text-decoration:none}
  #fp-offer-{{ product.id }} .fp-auth{display:flex;align-items:center;gap:12px;background:var(--fp-accent-soft);border-radius:14px;padding:12px 14px;margin-top:16px}
  #fp-offer-{{ product.id }} .fp-auth__img{position:relative;flex:0 0 auto}
  #fp-offer-{{ product.id }} .fp-auth__ph{width:74px;height:56px;border-radius:10px;border:2px dashed #e3b3ca;display:flex;align-items:center;justify-content:center;font-size:10px;color:#c98bab;text-align:center;background:#fff;line-height:1.2}
  #fp-offer-{{ product.id }} .fp-auth__count{position:absolute;left:-8px;bottom:-8px;background:var(--fp-accent);color:#fff;font-weight:800;font-size:12px;border-radius:50%;width:34px;height:34px;display:flex;align-items:center;justify-content:center;border:3px solid var(--fp-accent-soft)}
  #fp-offer-{{ product.id }} .fp-auth__text{margin:0;font-size:14px;line-height:1.35}
  #fp-offer-{{ product.id }} .fp-obj2{margin-top:18px}
  #fp-offer-{{ product.id }} .fp-obj2__eyebrow{color:var(--fp-accent);font-weight:800;letter-spacing:1px;font-size:11px;margin:0 0 4px}
  #fp-offer-{{ product.id }} .fp-obj2__title{font-size:20px;font-weight:800;color:#111;margin:0 0 10px}
  #fp-offer-{{ product.id }} .fp-obj2__i{border-bottom:1px solid #ececec}
  #fp-offer-{{ product.id }} .fp-obj2__i summary{list-style:none;cursor:pointer;font-weight:700;font-size:15px;color:#1b1b1b;padding:15px 30px 15px 0;position:relative}
  #fp-offer-{{ product.id }} .fp-obj2__i summary::-webkit-details-marker{display:none}
  #fp-offer-{{ product.id }} .fp-obj2__i summary:after{content:"+";position:absolute;right:4px;top:13px;font-size:22px;color:var(--fp-accent);font-weight:400}
  #fp-offer-{{ product.id }} .fp-obj2__i[open] summary:after{content:"×"}
  #fp-offer-{{ product.id }} .fp-obj2__i > div{padding:0 0 16px;color:#555;font-size:14px;line-height:1.6}
  #fp-offer-{{ product.id }} .fp-obj2__i b{color:#111}

  @media(max-width:600px){
    #fp-offer-{{ product.id }} .fp-tier{gap:10px;padding:16px 12px;flex-wrap:wrap}
    #fp-offer-{{ product.id }} .fp-tier__thumbwrap{flex:0 0 46px;width:46px;height:46px}
    #fp-offer-{{ product.id }} .fp-tier__body{flex:1 1 auto;min-width:0}
    #fp-offer-{{ product.id }} .fp-tier__name{font-size:15px}
    #fp-offer-{{ product.id }} .fp-tier__meta{font-size:12px;white-space:normal}
    #fp-offer-{{ product.id }} .fp-tier__pricecol{flex:1 0 100%;flex-direction:row;flex-wrap:wrap;align-items:baseline;justify-content:flex-start;gap:4px 10px;text-align:left;margin-top:10px}
    #fp-offer-{{ product.id }} .fp-tier__old,#fp-offer-{{ product.id }} .fp-tier__new,#fp-offer-{{ product.id }} .fp-tier__save{white-space:normal}
    #fp-offer-{{ product.id }} .fp-tier__new{font-size:17px}
    #fp-offer-{{ product.id }} .fp-tier__badge{right:12px}
  }
  #fp-offer-{{ product.id }} .fp-price__new{color:var(--fp-accent);font-size:28px;font-weight:800;line-height:1.05}
  #fp-offer-{{ product.id }} .fp-price__day{color:#555;font-size:14px}
  #fp-offer-{{ product.id }} .fp-price__day b{color:var(--fp-accent)}
  #fp-offer-{{ product.id }} .fp-price__chips span{display:inline-block;background:var(--fp-accent-soft);color:var(--fp-accent);font-weight:700;font-size:12px;border-radius:20px;padding:6px 12px;white-space:nowrap}
  #fp-offer-{{ product.id }} .fp-tier{flex-wrap:wrap;padding:18px 14px 14px}
  #fp-offer-{{ product.id }} .fp-tier--best{background:#fffafc}
  #fp-offer-{{ product.id }} .fp-tier__thumbwrap{position:relative}
  #fp-offer-{{ product.id }} .fp-tier__qty{position:absolute;right:-6px;bottom:-6px;background:#111;color:#fff;font-size:11px;font-weight:800;border-radius:10px;padding:2px 6px}
  #fp-offer-{{ product.id }} .fp-tier__body{flex:1 1 120px}
  #fp-offer-{{ product.id }} .fp-tier__gift{display:inline-flex;align-items:center;gap:5px;color:#1f8a4c;font-weight:700;font-size:13px}
  #fp-offer-{{ product.id }} .fp-tier__gift svg{width:15px;height:15px;flex:0 0 15px}
  #fp-offer-{{ product.id }} .fp-tier__pricecol{flex:0 0 auto!important;flex-direction:column!important;align-items:flex-end!important;text-align:right!important;margin-top:0!important}
  #fp-offer-{{ product.id }} .fp-tier__day{color:var(--fp-accent);font-weight:700;font-size:12px;white-space:nowrap}
  #fp-offer-{{ product.id }} .fp-tier__save{flex:1 0 100%;margin-top:2px;background:#eef8f1;color:#1f8a4c;font-weight:700;font-size:12px;border-radius:8px;padding:6px 10px;white-space:normal}
  #fp-offer-{{ product.id }} .fp-hp{position:absolute!important;left:-9999px!important;width:1px!important;height:1px!important;opacity:0!important}
</style>

<script>
(function(){
  var root = document.getElementById('fp-offer-{{ product.id }}');
  if(!root) return;
  var pixelId = root.dataset.pixel, endpoint = root.dataset.endpoint;
  var contentId = root.dataset.contentId, currency = root.dataset.currency || 'EUR';
  if (pixelId && typeof window.fbq === 'undefined') {
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
    n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}
    (window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    window.fbq('init', pixelId);
  }
  var radios = root.querySelectorAll('input[name="fp-tier-{{ product.id }}"]');
  var orderForm = root.querySelector('[data-order-form]');
  var errEl = root.querySelector('[data-order-err]');
  var successEl = root.querySelector('[data-order-success]');
  var priceNew = root.querySelector('[data-price-new]'), priceOld = root.querySelector('[data-price-old]');
  var selEl = root.querySelector('[data-order-sel]');
  function selected(){ var r=root.querySelector('input[name="fp-tier-{{ product.id }}"]:checked'); return {packs:parseInt(r.dataset.packs,10),name:r.dataset.name,total:parseFloat(r.dataset.total),price:r.dataset.price,day:r.dataset.day,prop:r.dataset.prop,variantId:r.dataset.variant}; }
  var priceDay = root.querySelector('[data-price-day]');
  function syncUI(){
    radios.forEach(function(r){ r.closest('.fp-tier').classList.toggle('is-selected', r.checked); });
    var s=selected();
    if(priceNew){ priceNew.textContent = s.price; }
    if(priceDay){ priceDay.textContent = s.day; }
    if(selEl){ selEl.textContent = 'Избран пакет: ' + s.name + ' · ' + s.price; }
  }
  radios.forEach(function(r){ r.addEventListener('change', syncUI); });
  syncUI();
  var MB=['януари','февруари','март','април','май','юни','юли','август','септември','октомври','ноември','декември'];
  var els=root.querySelectorAll('[data-tl]'), base=new Date();
  els.forEach(function(el){ var d=new Date(base.getTime()); d.setDate(d.getDate()+parseInt(el.dataset.tl,10)); el.textContent=d.getDate()+' '+MB[d.getMonth()]; });
  var addBtn=root.querySelector('[data-add-cart]');
  if(addBtn){ addBtn.addEventListener('click', function(){ var s=selected(); addBtn.disabled=true; var old=addBtn.textContent; addBtn.textContent='Добавяне…';
    var _h={'Content-Type':'application/json','Accept':'application/json'};
    fetch('/cart/clear.js',{method:'POST',headers:_h}).then(function(){ return fetch('/cart/add.js',{method:'POST',headers:_h,body:JSON.stringify({items:[{id:s.variantId,quantity:1,properties:{'Пакет':s.prop}}]})}); })
    .then(function(r){ return r.json(); })
    .then(function(){ if(window.fbq){ window.fbq('track','AddToCart',{content_ids:[contentId],content_type:'product',value:s.total,currency:currency,num_items:s.packs}); } addBtn.disabled=false; addBtn.textContent=old; if(window.fpCart){ window.fpCart.open(); } else { window.location.href='/cart'; } })
    .catch(function(){ addBtn.disabled=false; addBtn.textContent=old; }); }); }
  if(orderForm){ orderForm.addEventListener('submit', function(e){ e.preventDefault(); errEl.hidden=true;
    if(orderForm.querySelector('input[name="fp_company"]').value){ return; }
    var name=orderForm.querySelector('input[name="fp_name"]').value.trim();
    var phone=orderForm.querySelector('input[name="fp_phone"]').value.trim();
    var digits=phone.replace(/[^0-9]/g,'');
    if(name.length<2){ errEl.textContent='Моля, въведете име.'; errEl.hidden=false; return; }
    if(digits.length<6){ errEl.textContent='Моля, въведете валиден телефон.'; errEl.hidden=false; return; }
    if(!endpoint){ errEl.textContent='Моля, обадете ни се на {{ phone }} и ще приемем поръчката по телефона.'; errEl.hidden=false; return; }
    var s=selected(); var isTest=/\btest\b|\bтест\b|notrack/i.test(name);
    var utm={}; try{ var q=new URLSearchParams(window.location.search); ['utm_source','utm_medium','utm_campaign','utm_content','utm_term','fbclid'].forEach(function(k){ utm[k]=q.get(k)||''; }); }catch(e2){}
    var data=new URLSearchParams();
    var f={lead_id:'FP-'+Date.now().toString(36).toUpperCase().slice(-6),name:name,phone:phone,package:s.name,packs:s.packs,total:s.total.toFixed(2),currency:currency,page:window.location.origin+window.location.pathname,referrer:document.referrer||'',user_agent:navigator.userAgent.slice(0,160)};
    Object.keys(f).forEach(function(k){ data.append(k,f[k]); }); Object.keys(utm).forEach(function(k){ data.append(k,utm[k]); });
    var _sub=orderForm.querySelector('button[type="submit"]'); if(_sub){ _sub.disabled=true; _sub.textContent='Изпращане…'; }
    fetch(endpoint,{method:'POST',mode:'no-cors',body:data,keepalive:true})
      .then(function(){
        if(!isTest && window.fbq){ window.fbq('track','InitiateCheckout',{value:s.total,currency:currency,content_ids:[contentId],content_name:'FitPatches',content_type:'product',num_items:s.packs}); }
        orderForm.hidden=true; successEl.hidden=false;
      })
      .catch(function(){ if(_sub){ _sub.disabled=false; _sub.textContent='Изпрати заявка'; } errEl.textContent='Нещо се обърка. Опитайте отново или ни се обадете на {{ phone }}.'; errEl.hidden=false; });
  }); }
  var _obj=root.querySelectorAll('.fp-obj2__i');
  _obj.forEach(function(d){ d.addEventListener('toggle',function(){ if(d.open){ _obj.forEach(function(o){ if(o!==d) o.open=false; }); } }); });
})();
</script>

