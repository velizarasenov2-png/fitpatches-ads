{%- comment -%}
  FitPatches — Оферта: цена на ден, пакети 1 / 2+1 / 3+2, поръчка с наложен платеж (количка → EasySell),
  бърза поръчка (име + телефон → Google таблица, без checkout), sticky бутон, отговори на въпроси.
  Цените идват от продуктите в Shopify (14,99 / 27,99 / 39,99 €) — тук се сменя само текстът.
{%- endcomment -%}
{%- liquid
  assign pixel_id = '1051819453965625'
  assign leads_endpoint = ''
  assign phone = '0887 459 494'
  assign content_id = 'fitpatches'
  assign cur = shop.currency
  assign ship_note = 'Доставка с Еконт до 2–4 работни дни'
  assign thumb = 'https://cdn.shopify.com/s/files/1/1019/0929/9545/files/fitpatches_2048_no_white_background.png?v=1773008342'
  assign t_names = '1 пакет|2+1 подарък|3+2 подарък' | split: '|'
  assign t_meta = '30 лепенки · за 1 месец|3 пакета · 90 лепенки · за 3 месеца|5 пакета · 150 лепенки · за 5 месеца' | split: '|'
  assign t_gift = 'x|+1 пакет подарък|+2 пакета подарък' | split: '|'
  assign t_packs = '1|3|5' | split: '|'
  assign t_ids = '53836021039441|53837384024401|53837385859409' | split: '|'
  assign t_total = '14.99|27.99|39.99' | split: '|'
  assign t_price = '14,99 €|27,99 €|39,99 €' | split: '|'
  assign t_day = '0,50 €|0,31 €|0,27 €' | split: '|'
  assign t_save = 'x|Спестяваш 16,98 € спрямо 3 единични пакета|Спестяваш 34,96 € спрямо 5 единични пакета' | split: '|'
  assign t_badge = 'x|x|Най-изгодно' | split: '|'
  assign t_prop = 'FitPatches 1 пакет (30 лепенки)|FitPatches 2+1 подарък — 3 пакета (90 лепенки)|FitPatches 3+2 подарък — 5 пакета (150 лепенки)' | split: '|'
  assign default_tier = 3
-%}

<section class="fp-offer" id="fp-offer-{{ product.id }}"
  data-pixel="{{ pixel_id }}" data-endpoint="{{ leads_endpoint }}"
  data-content-id="{{ content_id }}" data-currency="{{ cur }}" data-phone="{{ phone }}">
  <div class="fp-offer__wrap">

    {%- comment -%} Цена на избрания пакет + цена на ден {%- endcomment -%}
    <div class="fp-price">
      <div class="fp-price__nums">
        <span class="fp-price__new" data-price-new>{{ t_price[2] }}</span>
        <span class="fp-price__day">само <b data-price-day>{{ t_day[2] }}</b> на ден</span>
      </div>
      <div class="fp-price__chips">
        <span>Плащане при доставка</span>
        <span>30 дни гаранция</span>
      </div>
    </div>

    {%- comment -%} Ползи {%- endcomment -%}
    <ul class="fp-benefits">
      <li><span class="fp-bic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l2.5 2.5"/></svg></span><span><b>Една лепенка сутрин</b> — подкрепа за контрола на апетита и желанието за сладко през деня.</span></li>
      <li><span class="fp-bic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20C4 12 10 5 20 4c-1 9-7 16-16 16z"/><path d="M4 20c3-6 7-9.5 12-11.5"/></svg></span><span><b>Без хапчета за гълтане.</b> Берберин, канела и нар в тънка лепенка, която не се вижда под дрехите.</span></li>
      <li><span class="fp-bic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/></svg></span><span><b>Плащаш при доставка</b> — без карта, без абонамент и без предплащане.</span></li>
      <li><span class="fp-bic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5.5c0 4.2-3 7.2-7 8.5-4-1.3-7-4.3-7-8.5V6z"/><path d="M9 12l2 2 4-4"/></svg></span><span><b>30 дни гаранция:</b> ако не си доволна, обади ни се и ще ти върнем парите.</span></li>
    </ul>

    <div class="fp-divider"></div>

    {%- comment -%} Пакети {%- endcomment -%}
    <h2 class="fp-offer__title">Избери своя пакет</h2>
    <p class="fp-offer__sub">Колкото по-голям е пакетът, толкова по-ниска е цената на ден — и не се налага да поръчваш отново.</p>

    <div class="fp-offer__tiers" role="radiogroup" aria-label="Изберете пакет" data-tiers>
      {%- for name in t_names -%}
        {%- assign i = forloop.index0 -%}
        {%- assign idx = forloop.index -%}
        <label class="fp-tier{% if idx == default_tier %} is-selected{% endif %}{% if t_badge[i] != 'x' %} fp-tier--best{% endif %}" data-tier="{{ idx }}">
          <input type="radio" name="fp-tier-{{ product.id }}" value="{{ idx }}"
            data-packs="{{ t_packs[i] }}" data-name="{{ name }}" data-variant="{{ t_ids[i] }}"
            data-total="{{ t_total[i] }}" data-price="{{ t_price[i] }}" data-day="{{ t_day[i] }}" data-prop="{{ t_prop[i] }}"
            {% if idx == default_tier %}checked{% endif %}>
          {%- if t_badge[i] != 'x' -%}<span class="fp-tier__badge">{{ t_badge[i] }}</span>{%- endif -%}
          <span class="fp-tier__radio" aria-hidden="true"></span>
          <span class="fp-tier__thumbwrap"><img class="fp-tier__thumb" src="{{ thumb }}" alt="" loading="lazy" width="64" height="64"><span class="fp-tier__qty">×{{ t_packs[i] }}</span></span>
          <span class="fp-tier__body">
            <span class="fp-tier__name">{{ name }}</span>
            <span class="fp-tier__meta">{{ t_meta[i] }}</span>
            {%- if t_gift[i] != 'x' -%}
              <span class="fp-tier__gift"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M19 12v9H5v-9"/><path d="M7.5 8a2.5 2.5 0 1 1 0-5C11 3 12 8 12 8s1-5 4.5-5a2.5 2.5 0 1 1 0 5"/></svg>{{ t_gift[i] }}</span>
            {%- endif -%}
          </span>
          <span class="fp-tier__pricecol">
            <span class="fp-tier__new">{{ t_price[i] }}</span>
            <span class="fp-tier__day">{{ t_day[i] }} / ден</span>
          </span>
          {%- if t_save[i] != 'x' -%}<span class="fp-tier__save">{{ t_save[i] }}</span>{%- endif -%}
        </label>
      {%- endfor -%}
    </div>

    <div class="fp-offer__actions" data-actions>
      <button type="button" class="fp-btn fp-btn--cart" data-add-cart>Поръчай с наложен платеж</button>
    </div>
    <ul class="fp-assure">
      <li>Плащаш на куриера, когато получиш пратката</li>
      <li>{{ ship_note }}</li>
      <li>30 дни гаранция за връщане на парите</li>
    </ul>

    {%- comment -%} Кога пристига (работни дни) {%- endcomment -%}
    <div class="fp-timeline">
      <div class="fp-tl__step"><span class="fp-tl__dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.3"/><circle cx="17" cy="20" r="1.3"/><path d="M3 4h2l2.2 11.2a1.5 1.5 0 0 0 1.5 1.2h7.6a1.5 1.5 0 0 0 1.5-1.2L21 8H6"/></svg></span><span class="fp-tl__d" data-tl="order">днес</span><small>Поръчваш</small></div>
      <div class="fp-tl__bar"></div>
      <div class="fp-tl__step"><span class="fp-tl__dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="1.5" y="6" width="12" height="9" rx="1"/><path d="M13.5 9h4l3 3v3h-7z"/><circle cx="6" cy="18" r="1.5"/><circle cx="17.5" cy="18" r="1.5"/></svg></span><span class="fp-tl__d" data-tl="ship"></span><small>Изпращаме</small></div>
      <div class="fp-tl__bar"></div>
      <div class="fp-tl__step"><span class="fp-tl__dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/></svg></span><span class="fp-tl__d" data-tl="deliver"></span><small>Получаваш</small></div>
    </div>

    {%- comment -%} Бърза поръчка: само име + телефон → Google таблица. Не минава през количка и checkout. {%- endcomment -%}
    <div class="fp-quick" id="fp-quick-{{ product.id }}">
      <strong class="fp-quick__title">Бърза поръчка по телефона</strong>
      <p class="fp-quick__lead">Остави име и телефон — ще ти се обадим, за да потвърдим пакета и адреса за доставка. Не плащаш нищо сега.</p>
      <div class="fp-order__sel" data-order-sel></div>
      <form class="fp-order" data-order-form novalidate>
        <div class="fp-order__row"><input type="text" name="fp_name" placeholder="Име и фамилия" autocomplete="name" required></div>
        <div class="fp-order__row"><input type="tel" name="fp_phone" placeholder="Телефон, напр. 0888 123 456" autocomplete="tel" inputmode="tel" required></div>
        <input type="text" name="fp_company" class="fp-hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <div class="fp-important">
          <p class="fp-important__title">ВАЖНО</p>
          <label class="fp-agree">
            <input type="checkbox" name="fp_agree" data-order-agree checked>
            <span>С поръчката си поемам ангажимент да получа и заплатя пратката си с наложен платеж. Разбирам, че при отказ на пратката ще бъда отбелязан(а) като некоректен клиент в системата на куриера (Еконт) и магазинът може да не приема мои бъдещи поръчки с наложен платеж.</span>
          </label>
        </div>
        <button type="submit" class="fp-btn fp-btn--submit">Изпрати заявка</button>
        <p class="fp-order__note">Използваме телефона ти само за потвърждение на поръчката.</p>
        <p class="fp-order__err" data-order-err hidden></p>
      </form>
      <div class="fp-order__success" data-order-success hidden>
        <strong data-success-title>Благодарим! Заявката е приета.</strong>
        <span data-success-text>Ще ти се обадим скоро, за да потвърдим поръчката.</span>
      </div>
    </div>

    <a class="fp-contact" href="tel:{{ phone | remove: ' ' }}">Имаш въпрос? Обади се на {{ phone }}</a>

    {%- comment -%} Отговори на въпросите преди поръчка {%- endcomment -%}
    <div class="fp-obj2">
      <p class="fp-obj2__eyebrow">ПРЕДИ ДА ПОРЪЧАШ</p>
      <h3 class="fp-obj2__title">Знаем какво си мислиш.</h3>
      <details class="fp-obj2__i" open><summary>„Как действа една лепенка?“</summary><div>FitPatches не „топи мазнини“. Лепенката съдържа <b>берберин, канела и екстракт от нар</b> и е създадена като ежедневна подкрепа за контрола на апетита — особено на желанието за сладко. Залепваш я сутрин и не мислиш за нея. Най-добре работи заедно с балансирано хранене и движение.</div></details>
      <details class="fp-obj2__i"><summary>„Пробвах други добавки, но нямаше ефект.“</summary><div>Много хора спират добавките, защото забравят да ги пият или не понасят капсулите. Лепенката е <b>една на ден, без гълтане</b> — затова е по-лесно да си постоянна. Ако не си доволна, имаш 30 дни да ни се обадиш и да си върнеш парите.</div></details>
      <details class="fp-obj2__i"><summary>„Честно казано, звучи ми като измама.“</summary><div>Разбираме. Затова <b>не плащаш нищо предварително</b> — плащаш на куриера, когато получиш пратката. Имаш телефон за връзка {{ phone }} и 30 дни гаранция за връщане на парите. Не обещаваме „минус 10 кг за месец“ — обещаваме лесна ежедневна рутина.</div></details>
      <details class="fp-obj2__i"><summary>„Колко бързо ще усетя разлика?“</summary><div>Всеки организъм е различен, затова не обещаваме конкретни срокове или килограми. Препоръчваме <b>поне 2–3 месеца редовна употреба</b> — една лепенка на ден, заедно с балансирано хранене.</div></details>
      <details class="fp-obj2__i"><summary>„Колко пакета да взема?“</summary><div>Един пакет стига за 30 дни. Ако искаш само да пробваш — започни с 1 пакет. Ако искаш да изградиш навик, <b>3+2 подарък</b> стига за 5 месеца и излиза <b>0,27 € на ден</b> срещу 0,50 € при единичен пакет.</div></details>
      <details class="fp-obj2__i"><summary>„Има ли странични ефекти?“</summary><div>При чувствителна кожа лепилото може да зачерви мястото — сменяй мястото всеки ден. Не се препоръчва при бременност, кърмене, за деца и при прием на лекарства (особено за кръвна захар или кръвно налягане) — в тези случаи първо се консултирай с лекар. Не е лекарствен продукт.</div></details>
      <details class="fp-obj2__i"><summary>„А ако не съм доволна?“</summary><div>Обади ни се на {{ phone }} в рамките на <b>30 дни</b> от получаването и ще ти върнем парите.</div></details>
    </div>
  </div>
</section>

{%- comment -%} Sticky бутон (показва се, когато офертата излезе от екрана) {%- endcomment -%}
<div class="fp-sticky" id="fp-sticky-{{ product.id }}" aria-hidden="true">
  <div class="fp-sticky__info">
    <span class="fp-sticky__name" data-sticky-name>{{ t_names[2] }}</span>
    <span class="fp-sticky__price"><b data-sticky-price>{{ t_price[2] }}</b> · <span data-sticky-day>{{ t_day[2] }}</span> на ден</span>
  </div>
  <button type="button" class="fp-sticky__btn" data-sticky-go>Поръчай</button>
</div>

<style>
  #fp-offer-{{ product.id }}{--fp-accent:#d64d87;--fp-accent-dark:#b93a70;--fp-accent-soft:#fbe9f1;--fp-warm:#faf0f4;--fp-green:#1f8a4c}
  #fp-offer-{{ product.id }} .fp-offer__wrap{font-family:inherit;max-width:100%;margin:0;padding:8px 0;font-size:16px;color:#1b1b1b}
  #fp-offer-{{ product.id }} b{color:#111;font-weight:700}
  #fp-offer-{{ product.id }} .fp-price{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin:0 0 20px}
  #fp-offer-{{ product.id }} .fp-price__nums{display:flex;flex-direction:column;gap:2px}
  #fp-offer-{{ product.id }} .fp-price__new{color:#111;font-size:30px;font-weight:800;line-height:1.05}
  #fp-offer-{{ product.id }} .fp-price__day{color:#555;font-size:14px}
  #fp-offer-{{ product.id }} .fp-price__day b{color:var(--fp-accent)}
  #fp-offer-{{ product.id }} .fp-price__chips{display:flex;flex-direction:column;gap:6px;align-items:flex-end}
  #fp-offer-{{ product.id }} .fp-price__chips span{background:var(--fp-accent-soft);color:var(--fp-accent-dark);font-weight:700;font-size:12px;border-radius:20px;padding:5px 11px;white-space:nowrap}
  #fp-offer-{{ product.id }} .fp-benefits{list-style:none;margin:0 0 20px;padding:0;display:flex;flex-direction:column;gap:14px}
  #fp-offer-{{ product.id }} .fp-benefits li{display:flex;gap:14px;align-items:flex-start;font-size:15px;line-height:1.5}
  #fp-offer-{{ product.id }} .fp-bic{flex:0 0 40px;width:40px;height:40px;border-radius:50%;background:var(--fp-accent-soft);color:var(--fp-accent);display:flex;align-items:center;justify-content:center}
  #fp-offer-{{ product.id }} .fp-bic svg{width:20px;height:20px}
  #fp-offer-{{ product.id }} .fp-divider{height:1px;background:#eee;margin:0 0 20px}
  #fp-offer-{{ product.id }} .fp-offer__title{font-family:inherit;font-size:24px;font-weight:800;margin:0 0 6px;color:#111}
  #fp-offer-{{ product.id }} .fp-offer__sub{color:#666;margin:0 0 18px;font-size:14px;line-height:1.45}
  #fp-offer-{{ product.id }} .fp-offer__tiers{display:flex;flex-direction:column;gap:14px}
  #fp-offer-{{ product.id }} .fp-tier{position:relative;display:flex;flex-wrap:wrap;align-items:center;gap:12px;border:2px solid #ececec;border-radius:16px;padding:18px 14px 14px;cursor:pointer;background:#fff;transition:border-color .15s,box-shadow .15s}
  #fp-offer-{{ product.id }} .fp-tier.is-selected{border-color:var(--fp-accent);box-shadow:0 0 0 3px var(--fp-accent-soft)}
  #fp-offer-{{ product.id }} .fp-tier--best{background:#fffafc}
  #fp-offer-{{ product.id }} .fp-tier input{position:absolute;opacity:0;pointer-events:none}
  #fp-offer-{{ product.id }} .fp-tier__radio{flex:0 0 22px;width:22px;height:22px;border:2px solid #cfcfcf;border-radius:50%;position:relative}
  #fp-offer-{{ product.id }} .fp-tier.is-selected .fp-tier__radio{border-color:var(--fp-accent)}
  #fp-offer-{{ product.id }} .fp-tier.is-selected .fp-tier__radio:after{content:"";position:absolute;inset:4px;border-radius:50%;background:var(--fp-accent)}
  #fp-offer-{{ product.id }} .fp-tier__thumbwrap{position:relative;flex:0 0 56px;width:56px;height:56px;border-radius:12px;background:var(--fp-warm);display:flex;align-items:center;justify-content:center;padding:5px}
  #fp-offer-{{ product.id }} .fp-tier__thumb{max-width:100%;max-height:100%;object-fit:contain}
  #fp-offer-{{ product.id }} .fp-tier__qty{position:absolute;right:-6px;bottom:-6px;background:#111;color:#fff;font-size:11px;font-weight:800;border-radius:10px;padding:2px 6px}
  #fp-offer-{{ product.id }} .fp-tier__body{flex:1 1 120px;min-width:0;display:flex;flex-direction:column;gap:3px}
  #fp-offer-{{ product.id }} .fp-tier__name{font-weight:800;font-size:17px;line-height:1.2}
  #fp-offer-{{ product.id }} .fp-tier__meta{color:#777;font-size:13px}
  #fp-offer-{{ product.id }} .fp-tier__gift{display:inline-flex;align-items:center;gap:5px;color:var(--fp-green);font-weight:700;font-size:13px}
  #fp-offer-{{ product.id }} .fp-tier__gift svg{width:15px;height:15px;flex:0 0 15px}
  #fp-offer-{{ product.id }} .fp-tier__pricecol{flex:0 0 auto;display:flex;flex-direction:column;align-items:flex-end;text-align:right;gap:2px}
  #fp-offer-{{ product.id }} .fp-tier__new{font-weight:800;font-size:19px;color:#111;line-height:1.15;white-space:nowrap}
  #fp-offer-{{ product.id }} .fp-tier__day{color:var(--fp-accent-dark);font-weight:700;font-size:12px;white-space:nowrap}
  #fp-offer-{{ product.id }} .fp-tier__save{flex:1 0 100%;margin-top:2px;background:#eef8f1;color:var(--fp-green);font-weight:700;font-size:12px;border-radius:8px;padding:6px 10px}
  #fp-offer-{{ product.id }} .fp-tier__badge{position:absolute;top:-11px;right:14px;background:var(--fp-accent);color:#fff;font-size:11px;font-weight:800;letter-spacing:.3px;padding:4px 11px;border-radius:20px}
  #fp-offer-{{ product.id }} .fp-offer__actions{margin-top:16px}
  #fp-offer-{{ product.id }} .fp-btn{border:0;border-radius:14px;padding:18px 20px;font-size:18px;font-weight:800;cursor:pointer;width:100%;font-family:inherit}
  #fp-offer-{{ product.id }} .fp-btn:active{transform:translateY(1px)}
  #fp-offer-{{ product.id }} .fp-btn[disabled]{opacity:.7;cursor:wait}
  #fp-offer-{{ product.id }} .fp-btn--cart,#fp-offer-{{ product.id }} .fp-btn--submit{background:var(--fp-accent);color:#fff}
  #fp-offer-{{ product.id }} .fp-assure{list-style:none;margin:12px 0 0;padding:0;display:flex;flex-direction:column;gap:6px}
  #fp-offer-{{ product.id }} .fp-assure li{position:relative;padding-left:22px;font-size:13px;color:#444;line-height:1.4}
  #fp-offer-{{ product.id }} .fp-assure li:before{content:"";position:absolute;left:3px;top:3px;width:9px;height:5px;border-left:2px solid var(--fp-green);border-bottom:2px solid var(--fp-green);transform:rotate(-45deg)}
  #fp-offer-{{ product.id }} .fp-timeline{display:flex;align-items:flex-start;justify-content:space-between;background:#fff;border:1px solid #eee;border-radius:14px;padding:14px 12px;margin:20px 0}
  #fp-offer-{{ product.id }} .fp-tl__step{display:flex;flex-direction:column;align-items:center;gap:4px;flex:0 0 auto;text-align:center}
  #fp-offer-{{ product.id }} .fp-tl__step small{color:#333;font-weight:700;font-size:12px}
  #fp-offer-{{ product.id }} .fp-tl__d{font-size:12px;color:#7a7a7a}
  #fp-offer-{{ product.id }} .fp-tl__dot{width:40px;height:40px;border-radius:50%;background:var(--fp-accent-soft);color:var(--fp-accent);display:flex;align-items:center;justify-content:center}
  #fp-offer-{{ product.id }} .fp-tl__dot svg{width:20px;height:20px}
  #fp-offer-{{ product.id }} .fp-tl__bar{flex:1;height:2px;background:var(--fp-accent);margin:18px 4px 0}
  #fp-offer-{{ product.id }} .fp-quick{margin-top:20px;border:2px solid #f6cfe1;background:#fff6fb;border-radius:16px;padding:18px;scroll-margin-top:80px}
  #fp-offer-{{ product.id }} .fp-quick__title{color:var(--fp-accent-dark);font-size:18px;display:block;margin-bottom:4px}
  #fp-offer-{{ product.id }} .fp-quick__lead{margin:0 0 12px;font-size:14px;color:#555;line-height:1.45}
  #fp-offer-{{ product.id }} .fp-order__row{margin-bottom:10px}
  #fp-offer-{{ product.id }} .fp-order input[type=text],#fp-offer-{{ product.id }} .fp-order input[type=tel]{width:100%;padding:14px;border:1.5px solid #edc9db;border-radius:10px;font-size:16px;background:#fff;font-family:inherit;box-sizing:border-box}
  #fp-offer-{{ product.id }} .fp-order input:focus{outline:none;border-color:var(--fp-accent)}
  #fp-offer-{{ product.id }} .fp-hp{position:absolute!important;left:-9999px!important;width:1px!important;height:1px!important;opacity:0!important}
  #fp-offer-{{ product.id }} .fp-order__note{margin:8px 0 0;font-size:12px;color:#888;text-align:center}
  #fp-offer-{{ product.id }} .fp-order__err{color:#c0392b;font-size:13px;margin:8px 0 0}
  #fp-offer-{{ product.id }} .fp-order__success{display:none;margin-top:8px;border:2px solid var(--fp-accent);border-radius:12px;padding:16px;background:#fff;flex-direction:column;gap:6px;text-align:center}
  #fp-offer-{{ product.id }} .fp-order__success:not([hidden]){display:flex}
  #fp-offer-{{ product.id }} .fp-order__sel{margin:0 0 12px;padding:10px 12px;border-radius:10px;background:var(--fp-accent-soft);color:var(--fp-accent-dark);font-weight:700;font-size:14px;text-align:center}
  #fp-offer-{{ product.id }} .fp-contact{display:block;text-align:center;margin-top:20px;border:1.5px solid var(--fp-accent-soft);color:var(--fp-accent-dark);font-weight:700;border-radius:12px;padding:14px;text-decoration:none}
  #fp-offer-{{ product.id }} .fp-obj2{margin-top:24px}
  #fp-offer-{{ product.id }} .fp-obj2__eyebrow{color:var(--fp-accent);font-weight:800;letter-spacing:1px;font-size:11px;margin:0 0 4px}
  #fp-offer-{{ product.id }} .fp-obj2__title{font-size:20px;font-weight:800;color:#111;margin:0 0 10px}
  #fp-offer-{{ product.id }} .fp-obj2__i{border-bottom:1px solid #ececec}
  #fp-offer-{{ product.id }} .fp-obj2__i summary{list-style:none;cursor:pointer;font-weight:700;font-size:15px;color:#1b1b1b;padding:15px 30px 15px 0;position:relative}
  #fp-offer-{{ product.id }} .fp-obj2__i summary::-webkit-details-marker{display:none}
  #fp-offer-{{ product.id }} .fp-obj2__i summary:after{content:"+";position:absolute;right:4px;top:13px;font-size:22px;color:var(--fp-accent);font-weight:400}
  #fp-offer-{{ product.id }} .fp-obj2__i[open] summary:after{content:"×"}
  #fp-offer-{{ product.id }} .fp-obj2__i > div{padding:0 0 16px;color:#555;font-size:14px;line-height:1.6}
  #fp-offer-{{ product.id }} .fp-important{margin:14px 0 12px;padding:12px 14px;border:1.5px solid #e23b3b;background:#fff5f5;border-radius:10px}
  #fp-offer-{{ product.id }} .fp-important__title{margin:0 0 8px;color:#e23b3b;font-weight:800;font-size:13px;letter-spacing:1.5px}
  #fp-offer-{{ product.id }} .fp-agree{display:flex;gap:10px;align-items:flex-start;cursor:pointer}
  #fp-offer-{{ product.id }} .fp-agree input{flex:0 0 18px;width:18px;height:18px;margin:2px 0 0;accent-color:#e23b3b;cursor:pointer}
  #fp-offer-{{ product.id }} .fp-agree span{font-size:12.5px;line-height:1.5;color:#444}
  @media(max-width:600px){
    #fp-offer-{{ product.id }} .fp-tier{gap:10px;padding:18px 12px 12px}
    #fp-offer-{{ product.id }} .fp-tier__thumbwrap{flex:0 0 46px;width:46px;height:46px}
    #fp-offer-{{ product.id }} .fp-tier__name{font-size:16px}
    #fp-offer-{{ product.id }} .fp-tier__meta{font-size:12px}
    #fp-offer-{{ product.id }} .fp-tier__new{font-size:17px}
    #fp-offer-{{ product.id }} .fp-price__new{font-size:28px}
  }
  #fp-sticky-{{ product.id }}{position:fixed;left:0;right:0;bottom:0;z-index:9990;display:flex;align-items:center;gap:12px;padding:10px 14px calc(10px + env(safe-area-inset-bottom));background:#fff;border-top:1px solid #eee;box-shadow:0 -6px 20px rgba(0,0,0,.08);transform:translateY(110%);transition:transform .25s ease;font-family:inherit}
  #fp-sticky-{{ product.id }}.is-visible{transform:translateY(0)}
  #fp-sticky-{{ product.id }} .fp-sticky__info{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;line-height:1.25}
  #fp-sticky-{{ product.id }} .fp-sticky__name{font-weight:800;font-size:14px;color:#111;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  #fp-sticky-{{ product.id }} .fp-sticky__price{font-size:13px;color:#555}
  #fp-sticky-{{ product.id }} .fp-sticky__price b{color:#111}
  #fp-sticky-{{ product.id }} .fp-sticky__btn{flex:0 0 auto;border:0;border-radius:12px;background:#d64d87;color:#fff;font-weight:800;font-size:16px;padding:13px 22px;cursor:pointer;font-family:inherit}
  @media(min-width:990px){#fp-sticky-{{ product.id }}{left:auto;right:20px;bottom:20px;border-radius:14px;border:1px solid #eee;max-width:420px}}
</style>

<script>
(function(){
  var root = document.getElementById('fp-offer-{{ product.id }}');
  if (!root) return;
  var sticky = document.getElementById('fp-sticky-{{ product.id }}');
  var pixelId = root.dataset.pixel, endpoint = root.dataset.endpoint;
  var contentId = root.dataset.contentId, currency = root.dataset.currency || 'EUR', phoneNo = root.dataset.phone;
  if (pixelId && typeof window.fbq === 'undefined') {
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
    n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}
    (window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    window.fbq('init', pixelId);
  }

  /* UTM / fbclid — пазим първия източник за сесията, за да стигне до таблицата */
  var UTM_KEYS = ['utm_source','utm_medium','utm_campaign','utm_content','utm_term','fbclid'];
  var utm = {};
  try {
    var saved = JSON.parse(sessionStorage.getItem('fp_utm') || '{}');
    var qs = new URLSearchParams(window.location.search), fresh = {}, hasFresh = false;
    UTM_KEYS.forEach(function(k){ var v = qs.get(k); if (v) { fresh[k] = v; hasFresh = true; } });
    utm = hasFresh ? fresh : saved;
    if (hasFresh) sessionStorage.setItem('fp_utm', JSON.stringify(fresh));
  } catch(e) {}

  var radios = root.querySelectorAll('input[name="fp-tier-{{ product.id }}"]');
  function selected(){
    var r = root.querySelector('input[name="fp-tier-{{ product.id }}"]:checked') || radios[radios.length-1];
    return { packs: parseInt(r.dataset.packs,10), name: r.dataset.name, total: parseFloat(r.dataset.total),
             price: r.dataset.price, day: r.dataset.day, prop: r.dataset.prop, variantId: r.dataset.variant };
  }
  function setText(sel, txt, scope){ var el = (scope||root).querySelector(sel); if (el) el.textContent = txt; }
  function syncUI(){
    radios.forEach(function(r){ r.closest('.fp-tier').classList.toggle('is-selected', r.checked); });
    var s = selected();
    setText('[data-price-new]', s.price);
    setText('[data-price-day]', s.day);
    setText('[data-order-sel]', 'Избран пакет: ' + s.name + ' · ' + s.price);
    if (sticky) { setText('[data-sticky-name]', s.name, sticky); setText('[data-sticky-price]', s.price, sticky); setText('[data-sticky-day]', s.day, sticky); }
  }
  radios.forEach(function(r){ r.addEventListener('change', syncUI); });
  syncUI();

  /* Кога пристига: изпращане следващия работен ден, доставка 2–4 работни дни */
  var MB = ['януари','февруари','март','април','май','юни','юли','август','септември','октомври','ноември','декември'];
  function addBiz(d, n){ var x = new Date(d.getTime()); while (n > 0) { x.setDate(x.getDate()+1); var w = x.getDay(); if (w !== 0 && w !== 6) n--; } return x; }
  function fmt(d){ return d.getDate() + ' ' + MB[d.getMonth()]; }
  var now = new Date(), shipD = addBiz(now, 1), d1 = addBiz(now, 2), d2 = addBiz(now, 4);
  setText('[data-tl="ship"]', fmt(shipD));
  setText('[data-tl="deliver"]', d1.getMonth() === d2.getMonth() ? (d1.getDate() + '–' + fmt(d2)) : (fmt(d1) + ' – ' + fmt(d2)));

  /* Поръчай с наложен платеж: сменя количката с избрания пакет и отваря количката (EasySell формата е там) */
  var addBtn = root.querySelector('[data-add-cart]');
  function orderNow(){
    var s = selected(); addBtn.disabled = true; var old = addBtn.textContent; addBtn.textContent = 'Момент…';
    var hdr = {'Content-Type':'application/json','Accept':'application/json'};
    fetch('/cart/clear.js', {method:'POST', headers:hdr})
      .then(function(){ return fetch('/cart/add.js', {method:'POST', headers:hdr, body: JSON.stringify({items:[{id: s.variantId, quantity: 1, properties: {'Пакет': s.prop}}]})}); })
      .then(function(r){ if (!r.ok) throw new Error('add'); return r.json(); })
      .then(function(){
        if (window.fbq) { window.fbq('track','AddToCart',{content_ids:[contentId],content_type:'product',content_name:s.name,value:s.total,currency:currency,num_items:s.packs}); }
        addBtn.disabled = false; addBtn.textContent = old;
        if (window.fpCart) { window.fpCart.open(); } else { window.location.href = '/cart'; }
      })
      .catch(function(){ addBtn.disabled = false; addBtn.textContent = old; window.location.href = '/cart'; });
  }
  if (addBtn) addBtn.addEventListener('click', orderNow);

  /* Бърза поръчка → само Google таблица. Без количка и без checkout. */
  var orderForm = root.querySelector('[data-order-form]');
  var errEl = root.querySelector('[data-order-err]'), successEl = root.querySelector('[data-order-success]');
  function showErr(msg){ errEl.textContent = msg; errEl.hidden = false; }
  function showSuccess(name, phone, leadId){
    orderForm.hidden = true; successEl.hidden = false;
    setText('[data-success-title]', 'Благодарим, ' + name.split(' ')[0] + '! Заявката е приета.');
    setText('[data-success-text]', 'Ще ти се обадим на ' + phone + ', за да потвърдим поръчката. Номер на заявката: ' + leadId + '.');
  }
  if (orderForm) orderForm.addEventListener('submit', function(e){
    e.preventDefault(); errEl.hidden = true;
    if (orderForm.querySelector('[name="fp_company"]').value) { return; }
    var name = orderForm.querySelector('[name="fp_name"]').value.trim();
    var phone = orderForm.querySelector('[name="fp_phone"]').value.trim();
    var digits = phone.replace(/[^0-9]/g,'');
    if (name.length < 2) { showErr('Моля, въведи име.'); return; }
    var okPhone = (digits.indexOf('359') === 0 && digits.length === 12) || (digits.charAt(0) === '0' && digits.length === 10);
    if (!okPhone) { showErr('Моля, въведи валиден телефон (напр. 0888 123 456).'); return; }
    if (!orderForm.querySelector('[data-order-agree]').checked) { showErr('Моля, потвърди, че ще получиш пратката.'); return; }
    if (!endpoint) { showErr('В момента формата не работи. Обади ни се на ' + phoneNo + ' и ще приемем поръчката по телефона.'); if (window.console) console.warn('FitPatches: не е зададен адрес на Google таблицата (leads_endpoint).'); return; }

    var s = selected();
    var dupKey = 'fp_lead_' + digits;
    try { var prev = JSON.parse(localStorage.getItem(dupKey) || 'null'); if (prev && Date.now() - prev.t < 10*60*1000) { showSuccess(name, phone, prev.id); return; } } catch(e2) {}

    var leadId = 'FP-' + Date.now().toString(36).toUpperCase().slice(-6);
    var data = new URLSearchParams();
    var fields = { lead_id: leadId, name: name, phone: phone, package: s.name, packs: s.packs, total: s.total.toFixed(2), currency: currency,
                   page: window.location.origin + window.location.pathname, referrer: document.referrer || '', user_agent: navigator.userAgent.slice(0,160) };
    Object.keys(fields).forEach(function(k){ data.append(k, fields[k]); });
    UTM_KEYS.forEach(function(k){ data.append(k, utm[k] || ''); });

    var btn = orderForm.querySelector('button[type="submit"]'); btn.disabled = true; btn.textContent = 'Изпращане…';
    fetch(endpoint, { method:'POST', mode:'no-cors', body: data, keepalive: true })
      .then(function(){
        try { localStorage.setItem(dupKey, JSON.stringify({t: Date.now(), id: leadId})); } catch(e3) {}
        var isTest = /\btest\b|\bтест\b|notrack/i.test(name);
        if (!isTest && window.fbq) { window.fbq('track','Lead',{content_name:s.name,content_ids:[contentId],value:s.total,currency:currency,num_items:s.packs},{eventID:leadId}); }
        showSuccess(name, phone, leadId);
      })
      .catch(function(){
        btn.disabled = false; btn.textContent = 'Изпрати заявка';
        showErr('Нещо се обърка с връзката. Опитай отново или ни се обади на ' + phoneNo + '.');
      });
  });

  /* Sticky бутон: показва се, когато бутонът „Поръчай“ излезе нагоре от екрана */
  var actions = root.querySelector('[data-actions]'), tiers = root.querySelector('[data-tiers]');
  if (sticky && actions && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        var past = !en.isIntersecting && en.boundingClientRect.top < 0;
        sticky.classList.toggle('is-visible', past);
        sticky.setAttribute('aria-hidden', past ? 'false' : 'true');
      });
    });
    io.observe(actions);
    sticky.querySelector('[data-sticky-go]').addEventListener('click', function(){
      (tiers || root).scrollIntoView({behavior:'smooth', block:'start'});
    });
  }

  var _obj = root.querySelectorAll('.fp-obj2__i');
  _obj.forEach(function(d){ d.addEventListener('toggle', function(){ if (d.open) { _obj.forEach(function(o){ if (o !== d) o.open = false; }); } }); });
})();
</script>

{% render 'fp-drawer' %}
