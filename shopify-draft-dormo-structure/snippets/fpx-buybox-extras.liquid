{%- comment -%} FitPatches — кратки отзиви под формата за поръчка (същите като във Facebook секцията) {%- endcomment -%}
{%- liquid
  assign names = 'Катя Димитрова|Огнян Ахмедов'
  assign avatars = 'avatar-katya-dimitrova.jpg|avatar-ognian-ahmedov.jpg'
  assign quotes = 'След две седмици ползване имам много повече енергия и по-малко желание за сладко.|Вече не мисля за храна на всеки два часа. Чудесен резултат!'
  assign names = names | split: '|'
  assign avatars = avatars | split: '|'
  assign quotes = quotes | split: '|'
-%}
<div class="fpx-bx">
  {%- for q in quotes -%}
    {%- assign i = forloop.index0 -%}
    {%- assign av = images[avatars[i]] -%}
    <figure class="fpx-bx__card">
      <div class="fpx-bx__stars" aria-label="5 от 5">★★★★★</div>
      <blockquote>„{{ q }}“</blockquote>
      <figcaption>
        {%- if av != blank -%}<img src="{{ av | image_url: width: 80 }}" alt="{{ names[i] | escape }}" width="32" height="32" loading="lazy">{%- endif -%}
        <span>{{ names[i] }}</span>
      </figcaption>
    </figure>
  {%- endfor -%}
</div>
<style>
  .fpx-bx{display:grid;grid-template-columns:1fr;gap:10px;margin:16px 0 4px}
  .fpx-bx__card{margin:0;background:#faf0f4;border-radius:14px;padding:14px 16px}
  .fpx-bx__stars{color:#ffb400;font-size:14px;letter-spacing:1px;margin-bottom:4px}
  .fpx-bx__card blockquote{margin:0 0 10px;font-size:14.5px;line-height:1.5;color:#222;font-style:normal}
  .fpx-bx__card figcaption{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:700;color:#555}
  .fpx-bx__card figcaption img{width:32px;height:32px;border-radius:50%;object-fit:cover}
</style>
