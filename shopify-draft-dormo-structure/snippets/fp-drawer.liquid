{%- comment -%} FitPatches — плъзгаща количка (като на активния сайт). Draft тема: поръчката е през middleware.bg — скриптът му скрива линка към checkout и слага своя бутон след него. Стилът на оригиналния линк не се пипа (иначе middleware.bg добавя нов бутон при всяко обновяване), празната количка се маркира с клас .is-empty. {%- endcomment -%}
<div class="fpd" id="fpDrawer" aria-hidden="true">
  <div class="fpd__ov" data-fpd-close></div>
  <aside class="fpd__panel" role="dialog" aria-label="Количка">
    <div class="fpd__head">
      <span class="fpd__logo">Fit<span>Patches</span></span>
      <button class="fpd__x" type="button" data-fpd-close aria-label="Затвори">&times;</button>
    </div>
    <div class="fpd__body">
      <div class="fpd__items" data-fpd-items></div>
      <div class="fpd__up" data-fpd-upsell hidden>
        <p class="fpd__up-h">Може още да ти хареса</p>
        <div class="fpd__up-card">
          <img class="fpd__up-img" src="https://cdn.shopify.com/s/files/1/1019/0929/9545/files/fitpatches_2048_no_white_background.png?v=1773008342" alt="">
          <div class="fpd__up-info">
            <span class="fpd__up-name">3+2 подарък — 5 пакета</span>
            <span class="fpd__up-price"><s>119.96</s> <b>39.99</b></span>
          </div>
          <button class="fpd__up-add" type="button" data-fpd-upadd>Смени</button>
        </div>
      </div>
    </div>
    <div class="fpd__foot">
      <div class="fpd__tot">
        <div class="fpd__tot-row"><span>Крайна сума:</span><b data-fpd-total>0.00</b></div>
        <div class="fpd__tot-row fpd__tot-row--save" data-fpd-saverow hidden><span>Спестени:</span><b data-fpd-save></b></div>
      </div>
      <a class="fpd__go" href="/checkout">Преминаване към плащане</a>
      <div class="fpd__badges">
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/></svg>Наложен платеж</span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5.5c0 4.2-3 7.2-7 8.5-4-1.3-7-4.3-7-8.5V6z"/><path d="M9 12l2 2 4-4"/></svg>60 дни гаранция</span>
      </div>
    </div>
  </aside>
</div>
<style>
  #fpDrawer{--a:#d64d87;--soft:#fbe9f1;position:fixed;inset:0;z-index:99999;visibility:hidden;pointer-events:none}
  #fpDrawer.is-open{visibility:visible;pointer-events:auto}
  #fpDrawer .fpd__ov{position:absolute;inset:0;background:rgba(20,10,16,.45);opacity:0;transition:opacity .25s}
  #fpDrawer.is-open .fpd__ov{opacity:1}
  #fpDrawer .fpd__panel{position:absolute;top:0;right:0;height:100%;width:410px;max-width:92vw;background:#fff;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .28s cubic-bezier(.4,0,.2,1);box-shadow:-8px 0 30px rgba(0,0,0,.12);font-family:inherit}
  #fpDrawer.is-open .fpd__panel{transform:translateX(0)}
  #fpDrawer .fpd__head{display:flex;align-items:center;justify-content:space-between;padding:18px 20px;border-bottom:1px solid #f0e6ec}
  #fpDrawer .fpd__logo{font-size:22px;font-weight:800;color:#111;letter-spacing:-.5px}
  #fpDrawer .fpd__logo span{color:var(--a)}
  #fpDrawer .fpd__x{border:0;background:none;font-size:30px;line-height:1;color:#888;cursor:pointer;padding:0 4px}
  #fpDrawer .fpd__ship{padding:14px 20px 4px}
  #fpDrawer .fpd__ship-txt{margin:0 0 8px;font-size:13px;color:#444;text-align:center;font-weight:600}
  #fpDrawer .fpd__ship-txt b{color:var(--a)}
  #fpDrawer .fpd__ship-track{height:8px;border-radius:8px;background:#f0e6ec;overflow:hidden}
  #fpDrawer .fpd__ship-fill{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--a),#e87bab);border-radius:8px;transition:width .3s}
  #fpDrawer .fpd__body{flex:1;overflow-y:auto;padding:12px 20px}
  #fpDrawer .fpd__it{display:flex;gap:12px;padding:14px 0;border-bottom:1px solid #f4eef1}
  #fpDrawer .fpd__it-img{width:64px;height:64px;border-radius:10px;object-fit:contain;background:var(--soft);flex:0 0 64px;padding:4px}
  #fpDrawer .fpd__it-mid{flex:1;min-width:0}
  #fpDrawer .fpd__it-name{font-size:14px;font-weight:700;color:#111;line-height:1.25;margin:0 0 8px}
  #fpDrawer .fpd__qty{display:inline-flex;align-items:center;border:1px solid #e3d3dc;border-radius:20px;overflow:hidden}
  #fpDrawer .fpd__qty button{border:0;background:none;width:28px;height:28px;font-size:16px;cursor:pointer;color:var(--a);font-weight:700}
  #fpDrawer .fpd__qty span{min-width:22px;text-align:center;font-size:14px;font-weight:700}
  #fpDrawer .fpd__it-rm{display:block;margin-top:7px;border:0;background:none;color:#aaa;font-size:12px;text-decoration:underline;cursor:pointer;padding:0}
  #fpDrawer .fpd__it-price{text-align:right;white-space:nowrap;font-size:14px}
  #fpDrawer .fpd__it-price s{display:block;color:#b9b9b9;font-size:12px}
  #fpDrawer .fpd__it-price b{color:#111}
  #fpDrawer .fpd__empty{text-align:center;color:#999;padding:40px 0;font-size:15px}
  #fpDrawer .fpd__up{margin-top:8px;background:var(--soft);border-radius:14px;padding:14px}
  #fpDrawer .fpd__up-h{margin:0 0 10px;font-size:13px;font-weight:800;color:#111}
  #fpDrawer .fpd__up-card{display:flex;align-items:center;gap:12px}
  #fpDrawer .fpd__up-img{width:48px;height:48px;object-fit:contain;background:#fff;border-radius:10px;padding:3px;flex:0 0 48px}
  #fpDrawer .fpd__up-info{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}
  #fpDrawer .fpd__up-name{font-size:13px;font-weight:700;color:#111}
  #fpDrawer .fpd__up-price s{color:#b9b9b9;font-size:12px}
  #fpDrawer .fpd__up-price b{color:var(--a);font-size:14px}
  #fpDrawer .fpd__up-add{border:0;background:#fff;color:var(--a);border:1.5px solid var(--a);border-radius:20px;padding:8px 16px;font-weight:800;font-size:13px;cursor:pointer}
  #fpDrawer .fpd__foot{border-top:1px solid #f0e6ec;padding:16px 20px 20px}
  #fpDrawer .fpd__tot-row{display:flex;justify-content:space-between;align-items:baseline;font-size:15px;margin-bottom:4px}
  #fpDrawer .fpd__tot-row b{font-size:22px;font-weight:800;color:#111}
  #fpDrawer .fpd__tot-row--save b{font-size:15px;color:var(--a)}
  #fpDrawer .fpd__go{display:block;text-align:center;background:var(--a);color:#fff;font-weight:800;font-size:17px;border-radius:14px;padding:16px;text-decoration:none;margin:12px 0 12px}
  #fpDrawer .fpd__go:active{transform:translateY(1px)}
  #fpDrawer .fpd__badges{display:flex;justify-content:center;gap:22px}
  #fpDrawer .fpd__badges span{display:flex;align-items:center;gap:6px;font-size:12px;color:#666;font-weight:600}
  #fpDrawer .fpd__badges svg{width:18px;height:18px;color:var(--a)}
  #fpDrawer.is-empty .fpd__go{pointer-events:none;opacity:.5}
  body.fpd-lock{overflow:hidden}
  @media(max-width:600px){#fpDrawer .fpd__panel{width:100%;max-width:100%}}
</style>
<script>
(function(){
  var CUR='{{ shop.currency }}', UP_ID='53837385859409', UP_PROP='FitPatches 3+2 подарък — 5 пакета (150 лепенки)', THUMB='https://cdn.shopify.com/s/files/1/1019/0929/9545/files/fitpatches_2048_no_white_background.png?v=1773008342';
  var root=document.getElementById('fpDrawer'); if(!root) return;
  function m(c){ return (c/100).toFixed(2)+' '+CUR; }
  function esc(s){ return (s||'').replace(/[&<>"]/g,function(x){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[x];}); }
  var itemsEl=root.querySelector('[data-fpd-items]');
  var totEl=root.querySelector('[data-fpd-total]'), saveRow=root.querySelector('[data-fpd-saverow]'), saveEl=root.querySelector('[data-fpd-save]');
  var upEl=root.querySelector('[data-fpd-upsell]');
  function render(cart){
    var items=cart.items||[];
    if(!items.length){ itemsEl.innerHTML='<p class="fpd__empty">Количката е празна.</p>'; }
    else {
      itemsEl.innerHTML=items.map(function(it){
        var cmp=(it.compare_at_price && it.compare_at_price>it.final_price)?('<s>'+m(it.compare_at_price*it.quantity)+'</s>'):'';
        return '<div class="fpd__it" data-key="'+esc(it.key)+'">'
          +'<img class="fpd__it-img" src="'+(it.image||(it.featured_image&&it.featured_image.url)||THUMB)+'" alt="">'
          +'<div class="fpd__it-mid"><p class="fpd__it-name">'+esc((it.properties&&it.properties['Пакет'])||it.product_title)+'</p>'
          +'<div class="fpd__qty"><button type="button" data-dec>&minus;</button><span>'+it.quantity+'</span><button type="button" data-inc>+</button></div>'
          +'<button type="button" class="fpd__it-rm" data-rm>Премахни</button></div>'
          +'<div class="fpd__it-price">'+cmp+'<b>'+m(it.final_line_price)+'</b></div></div>';
      }).join('');
    }
    var total=cart.total_price/100;
    totEl.textContent=m(cart.total_price);
    var save=0; items.forEach(function(it){ if(it.compare_at_price && it.compare_at_price>it.final_price){ save+=(it.compare_at_price-it.final_price)*it.quantity; } });
    if(save>0){ saveRow.hidden=false; saveEl.textContent='-'+m(save); } else { saveRow.hidden=true; }
    var hasUp=items.some(function(it){ return String(it.variant_id)===UP_ID; });
    upEl.hidden = (hasUp || !items.length);
    root.classList.toggle('is-empty', !items.length);
  }
  function refresh(){ return fetch('/cart.js',{headers:{'Accept':'application/json'}}).then(function(r){return r.json();}).then(render); }
  function change(key,q){ return fetch('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({id:key,quantity:q})}).then(function(r){return r.json();}).then(render); }
  itemsEl.addEventListener('click',function(e){
    var row=e.target.closest('.fpd__it'); if(!row) return; var key=row.getAttribute('data-key');
    var qty=parseInt(row.querySelector('.fpd__qty span').textContent,10);
    if(e.target.closest('[data-inc]')) change(key,qty+1);
    else if(e.target.closest('[data-dec]')) change(key,Math.max(0,qty-1));
    else if(e.target.closest('[data-rm]')) change(key,0);
  });
  root.querySelector('[data-fpd-upadd]').addEventListener('click',function(){
    var h={'Content-Type':'application/json','Accept':'application/json'};
    fetch('/cart/clear.js',{method:'POST',headers:h}).then(function(){ return fetch('/cart/add.js',{method:'POST',headers:h,body:JSON.stringify({items:[{id:UP_ID,quantity:1,properties:{'Пакет':UP_PROP}}]})}); }).then(refresh);
  });
  function open(){ refresh(); root.classList.add('is-open'); root.setAttribute('aria-hidden','false'); document.body.classList.add('fpd-lock'); }
  function close(){ root.classList.remove('is-open'); root.setAttribute('aria-hidden','true'); document.body.classList.remove('fpd-lock'); }
  root.querySelectorAll('[data-fpd-close]').forEach(function(b){ b.addEventListener('click',close); });
  document.addEventListener('keydown',function(e){ if(e.key==='Escape') close(); });
  window.fpCart={open:open,close:close,refresh:refresh};
})();
</script>
{% render 'fp-quick-es' %}