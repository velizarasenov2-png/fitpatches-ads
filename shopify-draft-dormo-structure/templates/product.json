padding_percentage":0,"mobile_scroll_padding_pixels":14,"enable_mobile_outher_spacing":false,"mobile_slides_container_width":100,"mobile_slides_inner_width":100,"trust_badge_position":"top-right","trust_badge_size":"medium","mobile_padding_top":0,"mobile_padding_bottom":16,"desktop_padding_top":8,"desktop_padding_bottom":36}},"fp_features":{"type":"fp-features","settings":{}},"fpx_vs":{"type":"fpx-vs","settings":{"img_fp":"shopify://shop_images/fpx-vs-patch.jpg","img_other":"shopify://shop_images/fpx-vs-capsules.jpg"}},"fp_howworks":{"type":"fp-howworks","settings":{}},"fpx_layers":{"type":"fpx-layers","blocks":{"ly1":{"type":"layer","settings":{"heading":"Дишащ външен слой","text":"Пази активния слой и не оставя следи по дрехите."}},"ly2":{"type":"layer","settings":{"heading":"Активен слой","text":"Берберин и растителни екстракти, които се подават постепенно през деня."}},"ly3":{"type":"layer","settings":{"heading":"Мек лепилен слой","text":"Държи лепенката на място, без да дърпа кожата при сваляне."}},"ly4":{"type":"layer","settings":{"heading":"Защитно фолио","text":"Сваляш го точно преди да залепиш — лепенката е чиста до момента на употреба."}}},"block_order":["ly1","ly2","ly3","ly4"],"settings":{"image":"shopify://shop_images/fpx-layers.jpg"}},"fpx_nostomach":{"type":"fpx-nostomach","settings":{"image":"shopify://shop_images/fpx-nostomach.jpg"}},"fp_science":{"type":"fp-science","settings":{}},"fpx_timeline":{"type":"fpx-timeline","blocks":{"st1":{"type":"step","settings":{"when":"Първите дни","text":"Свикваш с лепенката — една сутрин и забравяш за нея. Някои усещат по-малко желание за сладко още тогава, други не. И двете са нормални."}},"st2":{"type":"step","settings":{"when":"Седмица 1 – 2","text":"Берберинът се подава постепенно всеки ден. Тук много клиенти казват, че вечер посягат по-рядко към сладкото."}},"st3":{"type":"step","settings":{"when":"Седмица 3 – 4","text":"Вече е навик. Съчетай лепенката с нормално хранене и малко движение — така промяната се задържа."}}},"block_order":["st1","st2","st3"],"settings":{"image":"shopify://shop_images/fpx-timeline.jpg"}},"fp_fb_reviews":{"type":"facebook-testimonials","blocks":{"post1":{"type":"column","settings":{"post_author":"Гинка Москова","post_author_verified":false,"post_time":"преди 1 час","post_text":"<p>Купих си 3 опаковки и вече свалих 4 кг за месец! Най-накрая нещо, което ми потиска апетита.</p>","post_reactions":"like, haha","post_reactions_text":"14","post_comments_text":"","comment_1_author":"","comment_1_author_verified":false,"comment_1_time":"","comment_1_text":"","comment_2_author":"","comment_2_author_verified":false,"comment_2_time":"","comment_2_text":"","post_author_avatar":"shopify://shop_images/avatar-ginka-moskova.jpg"}},"post2":{"type":"column","settings":{"post_author":"Гаврил Станков","post_author_verified":false,"post_time":"преди 1 час","post_text":"<p>Напълно доволен! Лепенките наистина помагат да се чувствам сит.</p>","post_reactions":"love","post_reactions_text":"7","post_comments_text":"","comment_1_author":"","comment_1_author_verified":false,"comment_1_time":"","comment_1_text":"","comment_2_author":"","comment_2_author_verified":false,"comment_2_time":"","comment_2_text":"","post_author_avatar":"shopify://shop_images/avatar-gavrail-stankov.jpg"}},"post3":{"type":"column","settings":{"post_author":"Боряна Атанасова","post_author_verified":false,"post_time":"преди 19 часа","post_text":"<p>Най-доброто решение за контрол на апетита, което съм опитвала.</p>","post_reactions":"love","post_reactions_text":"6","post_comments_text":"","comment_1_author":"","comment_1_author_verified":false,"comment_1_time":"","comment_1_text":"","comment_2_author":"","comment_2_author_verified":false,"comment_2_time":"","comment_2_text":"","post_author_avatar":"shopify://shop_images/avatar-boryana-atanasova-1.jpg"}},"post4":{"type":"column","settings":{"post_author":"Боряна Атанасова","post_author_verified":false,"post_time":"преди 19 часа","post_text":"<p>Свалих цели 2 кг благодарение на тези лепенки. Горещо ги препоръчвам!</p>","post_reactions":"like","post_reactions_text":"12","post_comments_text":"","comment_1_author":"","comment_1_author_verified":false,"comment_1_time":"","comment_1_text":"","comment_2_author":"","comment_2_author_verified":false,"comment_2_time":"","comment_2_text":"","post_author_avatar":"shopify://shop_images/avatar-boryana-atanasova-2.jpg"}},"post5":{"type":"column","settings":{"post_author":"Гинка Москова","post_author_verified":false,"post_time":"преди 1 ден","post_text":"<p>Използвам ги само от седмица, но вече виждам разлика. Определено действат.</p>","post_reactions":"like, love","post_reactions_text":"14","post_comments_text":"","comment_1_author":"","comment_1_author_verified":false,"comment_1_time":"","comment_1_text":"","comment_2_author":"","comment_2_author_verified":false,"comment_2_time":"","comment_2_text":"","post_author_avatar":"shopify://shop_images/avatar-ginka-moskova-2.jpg"}},"post6":{"type":"column","settings":{"post_author":"Мими Попова","post_author_verified":false,"post_time":"преди 1 час","post_text":"<p>Продуктът е страхотен! Не усещам глад през деня и вече виждам разлика в талията.</p>","post_reactions":"love","post_reactions_text":"9","post_comments_text":"","comment_1_author":"","comment_1_author_verified":false,"comment_1_time":"","comment_1_text":"","comment_2_author":"","comment_2_author_verified":false,"comment_2_time":"","comment_2_text":"","post_author_avatar":"shopify://shop_images/avatar-mimi-popova.jpg"}},"post7":{"type":"column","settings":{"post_author":"Бане Демов","post_author_verified":false,"post_time":"преди 1 час","post_text":"<p>Откакто ги ползвам, се чувствам отлично, силно ги препоръчвам!</p>","post_reactions":"love","post_reactions_text":"7","post_comments_text":"","comment_1_author":"","comment_1_author_verified":false,"comment_1_time":"","comment_1_text":"","comment_2_author":"","comment_2_author_verified":false,"comment_2_time":"","comment_2_text":"","post_author_avatar":"shopify://shop_images/avatar-bane-demov.jpg"}},"post8":{"type":"column","settings":{"post_author":"Ваня Димова","post_author_verified":true,"post_time":"преди 9 часа","post_text":"<p>Най-доброто решение за контрол на апетита, което съм опитвала.</p>","post_reactions":"love","post_reactions_text":"6","post_comments_text":"","comment_1_author":"","comment_1_author_verified":false,"comment_1_time":"","comment_1_text":"","comment_2_author":"","comment_2_author_verified":false,"comment_2_time":"","comment_2_text":"","post_author_avatar":"shopify://shop_images/avatar-vanya-dimova.jpg"}},"post9":{"type":"column","settings":{"post_author":"Анелия Радулова","post_author_verified":false,"post_time":"преди 1 ден","post_text":"<p>Забелязвам, че порциите ми намаляха значително, откакто започнах да ползвам лепенките.</p>","post_reactions":"like","post_reactions_text":"10","post_comments_text":"","comment_1_author":"","comment_1_author_verified":false,"comment_1_time":"","comment_1_text":"","comment_2_author":"","comment_2_author_verified":false,"comment_2_time":"","comment_2_text":"","post_author_avatar":"shopify://shop_images/avatar-anelia-radulova.jpg"}},"post10":{"type":"column","settings":{"post_author":"Мариана Григорова","post_author_verified":false,"post_time":"преди 54 минути","post_text":"<p>Пробвах ги и съм много доволна! Апетитът ми е овладян!</p>","post_reactions":"like","post_reactions_text":"5","post_comments_text":"","comment_1_author":"","comment_1_author_verified":false,"comment_1_time":"","comment_1_text":"","comment_2_author":"","comment_2_author_verified":false,"comment_2_time":"","comment_2_text":"","post_author_avatar":"shopify://shop_images/avatar-mariana-grigorova.jpg"}},"post11":{"type":"column","settings":{"post_author":"Катя Димитрова","post_author_verified":false,"post_time":"преди 1 ден","post_text":"<p>След две седмици ползване, имам много повече енергия и по-малко желание за сладко.</p>","post_reactions":"like, love","post_reactions_text":"10","post_comments_text":"","comment_1_author":"","comment_1_author_verified":false,"comment_1_time":"","comment_1_text":"","comment_2_author":"","comment_2_author_verified":false,"comment_2_time":"","comment_2_text":"","post_author_avatar":"shopify://shop_images/avatar-katya-dimitrova.jpg"}},"post12":{"type":"column","settings":{"post_author":"Георги Ахмедов","post_author_verified":false,"post_time":"преди 2 дни","post_text":"<p>Вече година ги ползвам. Усещам се много по-добре и енергичен през целия ден.</p>","post_reactions":"love","post_reactions_text":"8","post_comments_text":"","comment_1_author":"","comment_1_author_verified":false,"comment_1_time":"","comment_1_text":"","comment_2_author":"","comment_2_author_verified":false,"comment_2_time":"","comment_2_text":"","post_author_avatar":"shopify://shop_images/avatar-georgi-ahmedov.jpg"}},"post13":{"type":"column","settings":{"post_author":"Огнян Ахмедов","post_author_verified":false,"post_time":"преди 22 часа","post_text":"<p>Вече не мисля за храна на всеки два часа. Чудесен резултат!</p>","post_reactions":"like","post_reactions_text":"6","post_comments_text":"","comment_1_author":"","comment_1_author_verified":false,"comment_1_time":"","comment_1_text":"","comment_2_author":"","comment_2_author_verified":false,"comment_2_time":"","comment_2_text":"","post_author_avatar":"shopify://shop_images/avatar-ognian-ahmedov.jpg"}},"post14":{"type":"column","settings":{"post_author":"Петя Галева","post_author_verified":false,"post_time":"преди 23 часа","post_text":"<p>Усещането за глад е много по-слабо и съм успяла да сваля 3 кг.</p>","post_reactions":"love","post_reactions_text":"13","post_comments_text":"","comment_1_author":"","comment_1_author_verified":false,"comment_1_time":"","comment_1_text":"","comment_2_author":"","comment_2_author_verified":false,"comment_2_time":"","comment_2_text":"","post_author_avatar":"shopify://shop_images/avatar-petya-galeva-1.jpg"}},"post15":{"type":"column","settings":{"post_author":"Петя Галева","post_author_verified":false,"post_time":"преди 23 часа","post_text":"<p>Наистина ме изненадаха тези лепенки. Препоръчвам ги с две ръце.</p>","post_reactions":"love","post_reactions_text":"13","post_comments_text":"","comment_1_author":"","comment_1_author_verified":false,"comment_1_time":"","comment_1_text":"","comment_2_author":"","comment_2_author_verified":false,"comment_2_time":"","comment_2_text":"","post_author_avatar":"shopify://shop_images/avatar-petya-galeva-2.jpg"}}},"block_order":["post1","post2","post3","post4","post5","post6","post7","post8","post9","post10","post11","post12","post13","post14","post15"],"settings":{"display_id":false,"visibility":"always-display","title":"Какво казват клиентите ни във Facebook","title_highlight_color":"#6d388b","heading_size":"h1","text":"","color_scheme":"background-2","type":"slide","autoplay":false,"autoplay_speed":5,"arrows_color_scheme":"inverse","transparent_arrows":true,"dots_color_scheme":"inverse","desktop_full_page":false,"columns_desktop":3,"slider_desktop":false,"per_move_desktop":1,"desktop_spacing":24,"desktop_side_padding":0,"desktop_padding_calc":true,"desktop_adaptive_height":false,"desktop_dots_position":"under","desktop_arrows_position":"sides","slider_mobile":true,"enable_mobile_preview":false,"mobile_adaptive_height":false,"mobile_dots_position":"under","mobile_arrows_position":"under","post_bg_color":"#ffffff","post_text_color":"#101010","comments_bg_color":"#f0f2f5","separators_color":"#a4b0be","post_border_color":"#dfdfdf","border_width":1,"like_label":"Харесвам","comment_label":"Коментар","reply_label":"Отговор","share_label":"Сподели","padding_top":40,"padding_bottom":40,"custom_colors_background":"#f3f3f3","custom_gradient_background":"","custom_colors_text":"#2e2a39"}},"fpx_faq":{"type":"fpx-faq","blocks":{"f1":{"type":"category","settings":{"name":"За продукта"}},"f2":{"type":"qa","settings":{"q":"Какво е FitPatches?","a":"<p>Тънка лепенка с берберин и растителни екстракти. Слагаш я сутрин на чиста кожа и активните съставки се подават постепенно през деня. Отвън е затворена — нищо не остава по дрехите.</p>"}},"f3":{"type":"qa","settings":{"q":"Какво съдържа?","a":"<p>Берберин и растителни екстракти. Пълният състав е написан на опаковката.</p>"}},"f4":{"type":"qa","settings":{"q":"Защо през кожата, а не на капсули?","a":"<p>Капсулите минават през стомаха и черния дроб, където част от берберина се губи, а при много хора дразнят стомаха. Лепенката заобикаля стомаха и подава съставките бавно и равномерно.</p>"}},"f5":{"type":"qa","settings":{"q":"FitPatches лекарство ли е?","a":"<p>Не. FitPatches не е лекарство, не лекува и не замества терапия, назначена от лекар.</p>"}},"f6":{"type":"category","settings":{"name":"Употреба"}},"f7":{"type":"qa","settings":{"q":"Къде да я залепя?","a":"<p>На чиста и суха кожа — ръка, корем или бедро. Сменяй мястото всеки ден, за да не се дразни едно и също петно.</p>"}},"f8":{"type":"qa","settings":{"q":"Кога да я слагам?","a":"<p>Сутрин, след като кожата е чиста и суха. Носи я през деня и следвай указанията на опаковката.</p>"}},"f9":{"type":"qa","settings":{"q":"Ако забравя един ден?","a":"<p>Нищо страшно — продължаваш на следващия ден. Не слагай две наведнъж, за да наваксаш.</p>"}},"f10":{"type":"category","settings":{"name":"Безопасност"}},"f11":{"type":"qa","settings":{"q":"Има ли странични ефекти?","a":"<p>Съставките са растителни и обикновено се понасят добре. Ако кожата се зачерви или засърби, махни лепенката и смени мястото. Ако раздразнението продължи, спри употребата.</p>"}},"f12":{"type":"qa","settings":{"q":"Мога ли, ако пия лекарства?","a":"<p>Берберинът може да влияе на действието на някои лекарства — например за кръвна захар или кръвно налягане. Ако пиеш лекарства всеки ден, първо попитай лекаря си.</p>"}},"f13":{"type":"qa","settings":{"q":"При бременност и кърмене?","a":"<p>Не използвай FitPatches при бременност и кърмене без консултация с лекар.</p>"}},"f14":{"type":"category","settings":{"name":"Резултати"}},"f15":{"type":"qa","settings":{"q":"За колко време ще усетя разлика?","a":"<p>При всеки е различно. Много клиенти усещат по-малко желание за храна още в първите дни. За видима промяна дай на тялото 4–8 седмици — по една лепенка на ден.</p>"}},"f16":{"type":"qa","settings":{"q":"Ами ако не усетя нищо?","a":"<p>Затова започваш без риск — плащаш при получаване. Пробвай един пакет и ако не усетиш разлика в апетита, просто не поръчваш пак.</p>"}},"f17":{"type":"category","settings":{"name":"Поръчка и доставка"}},"f18":{"type":"qa","settings":{"q":"Как плащам?","a":"<p>С наложен платеж — плащаш на куриера, когато получиш пратката. Без предплащане.</p>"}},"f19":{"type":"qa","settings":{"q":"За колко време пристига?","a":"<p>Изпращаме с Еконт до адрес или офис. Обикновено пристига за 2–4 работни дни.</p>"}},"f20":{"type":"qa","settings":{"q":"За колко стига един пакет?","a":"<p>30 лепенки — по една на ден, точно за един месец.</p>"}},"f21":{"type":"qa","settings":{"q":"Има ли абонамент?","a":"<p>Няма. Плащаш веднъж за това, което поръчаш. Няма автоматични плащания.</p>"}}},"block_order":["f1","f2","f3","f4","f5","f6","f7","f8","f9","f10","f11","f12","f13","f14","f15","f16","f17","f18","f19","f20","f21"],"settings":{}},"fp_vs":{"type":"fp-vs","disabled":true,"settings":{}},"fp_results":{"type":"fp-results","disabled":true,"settings":{}},"fp_analysis":{"type":"fp-analysis","disabled":true,"settings":{}},"fp_img_collage":{"type":"fp-image-slot","disabled":true,"settings":{"label":"Място за снимка: много хора използват FitPatches (колаж)","height":"360"}}},"order":["main","fp_features","fpx_vs","fp_howworks","fpx_layers","fpx_nostomach","fp_science","fpx_timeline","fp_fb_reviews","fpx_faq","fp_vs","fp_results","fp_analysis","fp_img_collage"]}