{%- comment -%} FitPatches — голям FAQ по категории (блокове „Категория“ + „Въпрос“) {%- endcomment -%}
<section class="fpx-faq" id="fpxfaq-{{ section.id }}">
  <div class="fpx-faq__wrap">
    <p class="fpx-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="fpx-faq__title">{{ section.settings.title }}</h2>
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'category' -%}
          <p class="fpx-faq__cat" {{ block.shopify_attributes }}>{{ block.settings.name }}</p>
        {%- when 'qa' -%}
          <details class="fpx-faq__qa" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.q }}<span class="fpx-faq__ic" aria-hidden="true"></span></summary>
            <div class="fpx-faq__a">{{ block.settings.a }}</div>
          </details>
      {%- endcase -%}
    {%- endfor -%}
    {%- if section.settings.contact != blank -%}
      <div class="fpx-faq__contact">{{ section.settings.contact }}</div>
    {%- endif -%}
  </div>
</section>
<style>
  #fpxfaq-{{ section.id }}{--a:#d64d87;--soft:#fbe9f1;--warm:#faf0f4;background:var(--warm)}
  #fpxfaq-{{ section.id }} .fpx-faq__wrap{max-width:760px;margin:0 auto;padding:52px 18px}
  #fpxfaq-{{ section.id }} .fpx-eyebrow{text-align:center;color:var(--a);font-weight:800;letter-spacing:1px;font-size:12px;margin:0 0 8px;text-transform:uppercase}
  #fpxfaq-{{ section.id }} .fpx-faq__title{text-align:center;font-size:30px;font-weight:800;color:#111;line-height:1.2;margin:0 0 26px}
  #fpxfaq-{{ section.id }} .fpx-faq__cat{font-size:12px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;color:var(--a);margin:26px 0 10px}
  #fpxfaq-{{ section.id }} .fpx-faq__qa{background:#fff;border-radius:14px;margin-bottom:8px;box-shadow:0 1px 0 rgba(0,0,0,.04)}
  #fpxfaq-{{ section.id }} .fpx-faq__qa summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:14px;padding:16px 18px;font-weight:700;font-size:15.5px;color:#111}
  #fpxfaq-{{ section.id }} .fpx-faq__qa summary::-webkit-details-marker{display:none}
  #fpxfaq-{{ section.id }} .fpx-faq__ic{flex:0 0 22px;height:22px;border-radius:50%;background:var(--soft);position:relative}
  #fpxfaq-{{ section.id }} .fpx-faq__ic:before,#fpxfaq-{{ section.id }} .fpx-faq__ic:after{content:"";position:absolute;left:6px;right:6px;top:10px;height:2px;background:var(--a);border-radius:2px;transition:transform .2s}
  #fpxfaq-{{ section.id }} .fpx-faq__ic:after{transform:rotate(90deg)}
  #fpxfaq-{{ section.id }} .fpx-faq__qa[open] .fpx-faq__ic:after{transform:rotate(0)}
  #fpxfaq-{{ section.id }} .fpx-faq__a{padding:0 18px 16px;color:#555;font-size:14.5px;line-height:1.6}
  #fpxfaq-{{ section.id }} .fpx-faq__a p{margin:0 0 8px}
  #fpxfaq-{{ section.id }} .fpx-faq__contact{text-align:center;margin-top:24px;font-size:15px;color:#333}
  #fpxfaq-{{ section.id }} .fpx-faq__contact a{color:var(--a);font-weight:800}
  @media(max-width:749px){
    #fpxfaq-{{ section.id }} .fpx-faq__title{font-size:24px}
  }
</style>
{% schema %}
{
  "name": "FPX Въпроси по категории",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Надзаглавие", "default": "Въпроси" },
    { "type": "text", "id": "title", "label": "Заглавие", "default": "Питаш — ние отговаряме" },
    { "type": "richtext", "id": "contact", "label": "Ред за контакт", "default": "<p>Не намираш отговор? Обади ни се на <a href=\"tel:0887459494\">0887 459 494</a></p>" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Категория",
      "settings": [ { "type": "text", "id": "name", "label": "Име", "default": "Категория" } ]
    },
    {
      "type": "qa",
      "name": "Въпрос",
      "settings": [
        { "type": "text", "id": "q", "label": "Въпрос", "default": "Въпрос" },
        { "type": "richtext", "id": "a", "label": "Отговор", "default": "<p>Отговор</p>" }
      ]
    }
  ],
  "presets": [ { "name": "FPX Въпроси по категории" } ]
}
{% endschema %}
